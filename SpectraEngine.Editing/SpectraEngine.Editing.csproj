<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Editing</RootNamespace>
    <!-- Runs the trim/AOT analysers on the ordinary build. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Core only, no Silk.NET package. Editor tooling must not bind to the
    windowing or input backend. Silk.NET still flows in transitively;
    EditingAssemblyBoundaryTests checks nothing here uses it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
  </ItemGroup>

</Project>
