<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Spectra.Kitchen</RootNamespace>
    <!-- The AOT-published editor hosts this library in process. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
    <!-- The shader rule runs the compiler in process, not through ssc. -->
    <ProjectReference Include="..\SpectraShade.Compiler\SpectraShade.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Block encoder. Here and not in Core: a shipped game never encodes. -->
    <PackageReference Include="BCnEncoder.Net" />
  </ItemGroup>

</Project>
