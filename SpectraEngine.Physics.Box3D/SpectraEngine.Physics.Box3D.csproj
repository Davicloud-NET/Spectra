<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Ships in game binaries: run the trim/AOT analysers on every build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
  </ItemGroup>

  <!-- box3d.dll is built by native/build-box3d.ps1 and not committed.
       A fresh clone without it must still compile, hence the Condition. -->
  <ItemGroup>
    <None Include="..\native\runtimes\win-x64\native\box3d.dll"
          Condition="Exists('..\native\runtimes\win-x64\native\box3d.dll')">
      <Link>box3d.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
