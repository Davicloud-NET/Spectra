<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Scripting.Luau</RootNamespace>
    <!-- Ships in game binaries: run the trim/AOT analysers on every build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />

    <!--
      Loaded as an analyzer, not referenced: its ScriptApiGenerator writes the
      binding of everything under Runtime that carries a script attribute.
      UndefineProperties: as in SpectraEngine.Entities.
    -->
    <ProjectReference Include="..\SpectraEngine.Entities.Generator\SpectraEngine.Entities.Generator.csproj"
                     OutputItemType="Analyzer"
                     ReferenceOutputAssembly="false"
                     UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained;PublishTrimmed;PublishSingleFile" />
  </ItemGroup>

  <!--
    The native library is not referenced here. The executable that runs
    scripts imports native/Luau.targets, which copies or links it.
  -->

</Project>
