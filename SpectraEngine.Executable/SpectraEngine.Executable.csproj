<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Editing and Entities are optional for a host. A shipped game drops them. -->
  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
    <ProjectReference Include="..\SpectraEngine.Editing\SpectraEngine.Editing.csproj" />
    <ProjectReference Include="..\SpectraEngine.Entities\SpectraEngine.Entities.csproj" />
    <ProjectReference Include="..\SpectraEngine.Physics.Box3D\SpectraEngine.Physics.Box3D.csproj" />
    <ProjectReference Include="..\SpectraShade.Compiler\SpectraShade.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!--
    The demo runs from loose files and has no cook in it, and the engine reads
    cooked sounds only. So the build cooks them: every WAV under Assets gets
    its .saudio in the output folder, where the copied content is. scook is
    built and run as a tool here. It is not a reference.
  -->
  <ItemGroup>
    <DemoSound Include="..\Assets\**\*.wav;..\Assets\**\*.wave" />
    <DemoSoundLabels Include="..\Assets\**\*.markers.txt" />
  </ItemGroup>

  <Target Name="CookDemoSounds"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'@(DemoSound)' != ''"
          Inputs="@(DemoSound);@(DemoSoundLabels)"
          Outputs="@(DemoSound->'$(OutDir)Assets\%(RecursiveDir)%(Filename).saudio')">
    <PropertyGroup>
      <_DemoSoundHost>dotnet</_DemoSoundHost>
      <_DemoSoundHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DemoSoundHost>
      <_DemoSoundSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'Assets'))</_DemoSoundSource>
      <_DemoSoundOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', 'Assets'))</_DemoSoundOutput>
    </PropertyGroup>

    <!--
      Without what a publish passes down: scook runs on this machine, as a
      plain build. Left in, it would be built self-contained for the demo's
      runtime.
    -->
    <MSBuild Projects="..\Spectra.Kitchen.CLI\Spectra.Kitchen.CLI.csproj"
             Targets="Build"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;_IsPublishing;_CommandLineDefinedRuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_DemoSoundCook" />
    </MSBuild>

    <Exec Command="&quot;$(_DemoSoundHost)&quot; &quot;@(_DemoSoundCook)&quot; sounds &quot;$(_DemoSoundSource)&quot; -o &quot;$(_DemoSoundOutput)&quot; -q --no-color" />

    <!-- So a clean removes them, and a build removes the one whose WAV is gone. -->
    <ItemGroup>
      <FileWrites Include="@(DemoSound->'$(OutDir)Assets\%(RecursiveDir)%(Filename).saudio')" />
    </ItemGroup>
  </Target>

  <!-- A publish takes the cooked sounds along with the content they sit in. -->
  <Target Name="PublishCookedDemoSounds" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CookedDemoSound Include="$(OutDir)Assets\**\*.saudio" />
      <ResolvedFileToPublish Include="@(_CookedDemoSound)"
                             RelativePath="Assets\%(_CookedDemoSound.RecursiveDir)%(_CookedDemoSound.Filename)%(_CookedDemoSound.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
