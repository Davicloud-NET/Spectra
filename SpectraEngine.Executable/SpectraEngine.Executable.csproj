<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      A publish is self-contained and scook is not. That is fine for a tool
      the build runs from its own folder. Without this: NETSDK1150.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- Editing and Entities are optional for a host. A shipped game drops them. -->
  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
    <ProjectReference Include="..\SpectraEngine.Editing\SpectraEngine.Editing.csproj" />
    <ProjectReference Include="..\SpectraEngine.Entities\SpectraEngine.Entities.csproj" />
    <ProjectReference Include="..\SpectraEngine.Physics.Box3D\SpectraEngine.Physics.Box3D.csproj" />
    <ProjectReference Include="..\SpectraShade.Compiler\SpectraShade.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!--
    scook, built before the demo and run by it as a tool. Not referenced:
    nothing of the cook reaches the demo. A reference all the same, so a
    restore of the demo restores scook too.
    UndefineProperties: scook runs on this machine as a plain build, in its
    own folder. Left in, a publish would build it self-contained for the
    demo's runtime, and -o would put it beside the demo.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Spectra.Kitchen.CLI\Spectra.Kitchen.CLI.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      OutputItemType="DemoSoundCook"
                      UndefineProperties="RuntimeIdentifier;SelfContained;_IsPublishing;_CommandLineDefinedRuntimeIdentifier;OutputPath;OutDir" />
  </ItemGroup>

  <!--
    The demo runs from loose files and has no cook in it, and the engine reads
    cooked sounds only. So every build cooks the WAVs under Assets into
    CookedSounds in the output folder, which DemoContent mounts. scook decides
    what is out of date, so nothing here says what a sound is.
  -->
  <Target Name="CookDemoSounds" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_DemoSoundHost>dotnet</_DemoSoundHost>
      <_DemoSoundHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DemoSoundHost>
      <_DemoSoundSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'Assets'))</_DemoSoundSource>
      <_DemoSoundOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', 'CookedSounds'))</_DemoSoundOutput>
    </PropertyGroup>

    <Exec Command="&quot;$(_DemoSoundHost)&quot; &quot;@(DemoSoundCook)&quot; sounds &quot;$(_DemoSoundSource)&quot; -o &quot;$(_DemoSoundOutput)&quot; -q --no-color" />

    <!-- So a clean removes them. -->
    <ItemGroup>
      <FileWrites Include="$(_DemoSoundOutput)\**\*" />
    </ItemGroup>
  </Target>

  <!-- A publish takes the cooked sounds along, and not their stamps. -->
  <Target Name="PublishCookedDemoSounds" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CookedDemoSound Include="$(OutDir)CookedSounds\**\*.saudio" />
      <ResolvedFileToPublish Include="@(_CookedDemoSound)"
                             RelativePath="CookedSounds\%(_CookedDemoSound.RecursiveDir)%(_CookedDemoSound.Filename)%(_CookedDemoSound.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
