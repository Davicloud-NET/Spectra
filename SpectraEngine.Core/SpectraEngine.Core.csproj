<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Runs the trim/AOT analysers on this project's ordinary build, not only at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Graphics\BaseShaders\**\*.spectrashade" />
    <EmbeddedResource Include="Graphics\BaseShaders\**\*.spectrashade" />
  </ItemGroup>

  <!--
    Content is copied to <output>\Assets so a deployed build resolves the same
    relative paths. TargetPath, not just Link, makes the copy flow to
    referencing projects.
  -->
  <ItemGroup>
    <Content Include="..\Assets\Textures\**\*.*"
             Link="Assets\Textures\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Textures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Materials\**\*.spectramat"
             Link="Assets\Materials\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Materials\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Whole folder: a .obj needs its .mtl, a .gltf may need a .bin. -->
    <Content Include="..\Assets\Models\**\*.*"
             Link="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Whole folder: a sound may have a label file beside it. -->
    <Content Include="..\Assets\Sounds\**\*.*"
             Link="Assets\Sounds\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="Assets\Sounds\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Only reference Silk.NET packages that code here uses. No metapackage:
    unused packages widen the AOT publish and the restore graph.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StbImageSharp" />
    <!-- XxHash128, for the .spack asset id and content digest. -->
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Silk.NET.Assimp" />
    <PackageReference Include="Silk.NET.Direct3D11" />
    <PackageReference Include="Silk.NET.Direct3D12" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" />
    <PackageReference Include="Silk.NET.DXGI" />
    <PackageReference Include="Silk.NET.GLFW" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Input.Glfw" />
    <PackageReference Include="Silk.NET.Maths" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <!--
      Native OpenAL runtime. No C# file names it, but Windows ships no OpenAL,
      so without it audio always falls into disabled mode.
    -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Windowing.Common" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
  </ItemGroup>

</Project>
