// Tone-maps the linear half-float scene into the display target, then draws
// the outline round whatever is in the outline mask.
//
// No pow() here: the target's sRGB format does the encode. Adding one would
// encode twice and wash the picture out.
//
// The outline is drawn here and not in a pass of its own because this is the
// one place that already has the finished pixel: mixing against it gives a
// smooth edge with no blend state, which the renderer has no neutral way to set.
//
// All three standard vertex attributes are declared although normal is unused.
// D3D11 builds every mesh's input layout from the lit shader's bytecode and
// rejects a smaller one at mesh creation.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader PostResolve {
    [Binding(0)] cbuffer Resolve {
        // x: exposure. y: 1 when there is a mask to read, else 0.
        vec4 uResolve;
        // xy: the outline's width as a step in mask UVs.
        vec4 uOutlineStep;
        // rgb: linear colour. a: strength.
        vec4 uOutlineSelected;
        vec4 uOutlineHovered;
    }

    [Binding(0)] sampler2D uSource;
    [Binding(1)] sampler2D uOutlineMask;

    // The strongest mask value on two rings round a pixel: the full width and
    // half of it. The half ring keeps a thin feature from slipping between taps.
    // The mask is filtered, so a tap that lands on a silhouette's edge returns
    // a fraction, and that fraction is the outline's soft outer edge.
    vec2 OutlineReach(vec2 uv, vec2 step) {
        vec2 diagonal = step * 0.7071;
        vec2 reach = uOutlineMask.Sample(uv + vec2(step.x, 0.0)).rg;
        reach = Math.Max(reach, uOutlineMask.Sample(uv - vec2(step.x, 0.0)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(0.0, step.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv - vec2(0.0, step.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + diagonal).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv - diagonal).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(diagonal.x, -diagonal.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(-diagonal.x, diagonal.y)).rg);

        vec2 half = step * 0.5;
        vec2 halfDiagonal = diagonal * 0.5;
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(half.x, 0.0)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv - vec2(half.x, 0.0)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(0.0, half.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv - vec2(0.0, half.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + halfDiagonal).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv - halfDiagonal).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(halfDiagonal.x, -halfDiagonal.y)).rg);
        reach = Math.Max(reach, uOutlineMask.Sample(uv + vec2(-halfDiagonal.x, halfDiagonal.y)).rg);
        return reach;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        // The triangle is authored in clip space.
        output.position = vec4(input.position, 1.0);
        output.uv = input.uv;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec3 color = uSource.Sample(input.uv).rgb * uResolve.x;

        // Narkowicz's ACES fit. Clamp negatives first: the curve turns them
        // into bright artefacts.
        color = Math.Max(color, vec3(0.0, 0.0, 0.0));
        vec3 numerator = color * (2.51 * color + 0.03);
        vec3 denominator = color * (2.43 * color + 0.59) + 0.14;
        vec3 mapped = Math.Clamp(numerator / denominator, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));

        if (uResolve.y > 0.5) {
            // Only outside the silhouette: where a neighbour is covered and
            // this pixel is not.
            vec2 inside = uOutlineMask.Sample(input.uv).rg;
            vec2 edge = Math.Clamp(OutlineReach(input.uv, uOutlineStep.xy) - inside, vec2(0.0, 0.0), vec2(1.0, 1.0));

            mapped = Math.Mix(mapped, uOutlineHovered.rgb, edge.g * uOutlineHovered.a);
            mapped = Math.Mix(mapped, uOutlineSelected.rgb, edge.r * uOutlineSelected.a);
        }

        return vec4(mapped, 1.0);
    }
}
