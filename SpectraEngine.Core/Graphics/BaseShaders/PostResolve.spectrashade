// Tone-maps the linear half-float scene into the display target.
//
// No pow() here: the target's sRGB format does the encode. Adding one would
// encode twice and wash the picture out.
//
// All three standard vertex attributes are declared although normal is unused.
// D3D11 builds every mesh's input layout from the lit shader's bytecode and
// rejects a smaller one at mesh creation.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader PostResolve {
    [Binding(0)] cbuffer Resolve {
        float uExposure;
    }

    [Binding(0)] sampler2D uSource;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        // The triangle is authored in clip space.
        output.position = vec4(input.position, 1.0);
        output.uv = input.uv;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec3 color = uSource.Sample(input.uv).rgb * uExposure;

        // Narkowicz's ACES fit. Clamp negatives first: the curve turns them
        // into bright artefacts.
        color = Math.Max(color, vec3(0.0, 0.0, 0.0));
        vec3 numerator = color * (2.51 * color + 0.03);
        vec3 denominator = color * (2.43 * color + 0.59) + 0.14;
        vec3 mapped = numerator / denominator;

        return vec4(Math.Clamp(mapped, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)), 1.0);
    }
}
