// Shadow map depth pass. No colour target is bound.
//
// The fragment stage exists only because SpectraShade has no vertex-only
// pipeline. Keep it empty: it runs for every caster texel.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader ShadowDepth {
    [Binding(0)] cbuffer Transforms {
        // [PerInstance]: the compiler also emits a second vertex stage that
        // takes this matrix per instance. This stage is unchanged.
        [PerInstance] mat4 uModel;
        mat4 uLightViewProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uLightViewProjection * uModel * vec4(input.position, 1.0);
        output.uv = input.uv;
        return output;
    }

    [Fragment]
    void FragmentMain(FragmentInput input) {
    }
}
