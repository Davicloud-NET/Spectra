// Built-in forward lit shader: Lambert diffuse plus hemisphere ambient.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 worldNormal;
    vec3 worldPosition;
    vec2 uv;
}

struct FragmentInput {
    vec3 worldNormal;
    vec3 worldPosition;
    vec2 uv;
}

shader Lit {
    [Binding(0)] cbuffer Transforms {
        mat4 uModel;
        mat4 uView;
        mat4 uProjection;
    }

    [Binding(1)] cbuffer Lighting {
        vec3 uBaseColor;
    }

    // Separate from Lighting: D3D uploads a whole cbuffer when any member
    // changes, and uBaseColor changes per draw while these change per frame.
    [Binding(2)] cbuffer Lights {
        vec4[8] uLightPositions;
        vec4[8] uLightColors;
        vec4[8] uLightAxis;
        vec4[8] uLightTangent;
        int uLightCount;
        float uAmbient;
        vec3 uAmbientSky;
        vec3 uAmbientGround;
    }

    [Binding(0)] sampler2D uDiffuse;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * uModel * vec4(input.position, 1.0);
        output.worldNormal = mat3(uModel) * input.normal;
        output.worldPosition = (uModel * vec4(input.position, 1.0)).xyz;
        output.uv = input.uv;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec3 n = Math.Normalize(input.worldNormal);
        vec3 albedo = uBaseColor * uDiffuse.Sample(input.uv).rgb;

        // Same hemisphere as the deferred path; the two share one light rig.
        vec3 ambient = Math.Mix(uAmbientGround, uAmbientSky, n.y * 0.5 + 0.5);
        vec3 total = albedo * ambient * uAmbient;

        for (int i = 0; i < uLightCount; i = i + 1) {
            vec4 posRange = uLightPositions[i];
            vec4 colorType = uLightColors[i];
            vec4 axis = uLightAxis[i];

            vec3 radiance = colorType.rgb;
            float type = colorType.w;

            vec3 toLight = -posRange.xyz;
            float attenuation = 1.0;

            if (type > 0.5) {
                vec3 offset = posRange.xyz - input.worldPosition;
                float distance = Math.Length(offset);
                toLight = offset / Math.Max(distance, 0.0001);

                // Inverse-square, faded to zero at the range. Squared so the
                // edge does not show as a ring.
                float falloff = Math.Max(1.0 - distance / posRange.w, 0.0);
                attenuation = falloff * falloff / (1.0 + distance * distance);

                // Type 2 is a spot cone. Area lights are shaded as a one-sided
                // point at their centre in this path.
                if (type > 1.5) {
                    if (type < 2.5) {
                        float cosAngle = Math.Dot(axis.xyz, -toLight / Math.Max(Math.Length(toLight), 0.0001));
                        float t = (cosAngle - axis.w) / Math.Max(uLightTangent[i].w - axis.w, 0.0001);
                        t = Math.Clamp(t, 0.0, 1.0);
                        attenuation = attenuation * t * t;
                    } else {
                        attenuation = attenuation * Math.Max(
                            Math.Dot(axis.xyz, -toLight / Math.Max(Math.Length(toLight), 0.0001)), 0.0);
                    }
                }
            }

            // Divided by pi to match the deferred path's Lambert term.
            float ndotl = Math.Max(Math.Dot(n, Math.Normalize(toLight)), 0.0);
            total = total + albedo / 3.14159265 * radiance * ndotl * attenuation;
        }

        return vec4(total, 1.0);
    }
}
