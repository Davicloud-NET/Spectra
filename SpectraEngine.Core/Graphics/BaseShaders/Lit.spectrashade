// Built-in forward lit shader. Lights a surface the way the deferred light pass
// lights a G-buffer pixel: the lighting is the block the two files share.
// PipelineParityGlTests renders one scene through both paths and compares them.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 worldNormal;
    vec3 worldPosition;
    vec2 uv;

    // The clip position again. A fragment stage cannot read [Position], and
    // the shadow filter needs to know which pixel it is shading.
    vec4 clip;
}

struct FragmentInput {
    vec3 worldNormal;
    vec3 worldPosition;
    vec2 uv;
    vec4 clip;
}

shader Lit {
    [Binding(0)] cbuffer Transforms {
        mat4 uModel;
        mat4 uView;
        mat4 uProjection;
    }

    // The G-buffer pass's surface parameters, so one material drives both paths.
    [Binding(1)] cbuffer Surface {
        vec3 uBaseColor;
        float uRoughness;
        float uMetallic;
        float uAmbientOcclusion;
        vec3 uEmissive;
    }

    // Separate from Surface: D3D uploads a whole cbuffer when any member
    // changes, and Surface changes per draw while these change per frame.
    [Binding(2)] cbuffer Frame {
        vec3 uCameraPosition;
        float uAmbient;

        // Hemisphere ambient. The pair averages to luminance one, so uAmbient
        // alone sets the strength.
        vec3 uAmbientSky;
        vec3 uAmbientGround;

        int uLightCount;

        // This pass's pixel size. Only the shadow filter's dither uses it.
        vec2 uTargetSize;

        // Clip-space xy to uv as (scale.xy, bias.xy). Per backend because the
        // target's origin is.
        vec4 uNdcToUv;

        // Index of the light the shadow map was rendered for, or -1.
        int uShadowLightIndex;

        int uCascadeCount;

        // 0 disables shadowing, 1 is fully dark in shadow.
        float uShadowStrength;

        // One texel in a cascade's own 0..1 space.
        float uShadowTexel;

        // Small constant against depth quantisation. Acne is handled by the
        // raster bias in the depth pass, not here.
        float uShadowDepthBias;

        // PCF tap circle radius, in texels of the chosen cascade.
        float uShadowFilterRadius;

        // Parallel vec4 arrays, not a struct array: a struct array does nothing
        // on OpenGL and reports no error. DeferredLight says what each holds.
        vec4[8] uLightPositions;
        vec4[8] uLightColors;
        vec4[8] uLightAxis;
        vec4[8] uLightTangent;
    }

    [Binding(3)] cbuffer Shadows {
        // World position to one cascade's own 0..1 space.
        mat4[4] uWorldToShadow;

        // Per cascade: atlas quadrant as (u, v, scale), world texel size in w.
        vec4[4] uCascadeRects;
    }

    [Binding(0)] sampler2D uDiffuse;
    [Binding(1)] sampler2D uShadowMap;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * uModel * vec4(input.position, 1.0);
        output.worldNormal = mat3(uModel) * input.normal;
        output.worldPosition = (uModel * vec4(input.position, 1.0)).xyz;
        output.uv = input.uv;
        output.clip = output.position;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec3 n = Math.Normalize(input.worldNormal);
        vec3 v = Math.Normalize(uCameraPosition - input.worldPosition);

        // The G-buffer keeps albedo, occlusion and metalness in eight bits,
        // which clamps them. Clamped here too, or a material that runs out of
        // range looks different in the two paths.
        vec3 albedo = Math.Clamp(
            uBaseColor * uDiffuse.Sample(input.uv).rgb, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
        float ao = Math.Clamp(uAmbientOcclusion, 0.0, 1.0);
        float metallic = Math.Clamp(uMetallic, 0.0, 1.0);

        // The pixel being shaded, as the light pass counts them.
        vec2 ndc = input.clip.xy / input.clip.w;
        vec2 pixel = (ndc * uNdcToUv.xy + uNdcToUv.zw) * uTargetSize;

        vec3 lit = Lighting(input.worldPosition, n, v, albedo, uRoughness, metallic, ao, pixel);
        return vec4(lit + uEmissive, 1.0);
    }

    // Shared lighting begins. From here to the end marker the text is the same
    // in Lit and DeferredLight, because SpectraShade has no include.
    // LightingSourceTests compares the two.

    // Cone falloff between the inner and outer half-angles, both passed as cosines.
    // -l: l points toward the light, the axis points the way the light travels.
    float SpotFactor(vec4 axis, vec4 tangent, vec3 l) {
        float cosAngle = Math.Dot(axis.xyz, -l);
        float outer = axis.w;
        float inner = tangent.w;

        // inner can equal outer.
        float t = (cosAngle - outer) / Math.Max(inner - outer, 0.0001);
        t = Math.Clamp(t, 0.0, 1.0);

        // Squared: a linear ramp shows as a band at the cone's edge.
        return t * t;
    }

    // The point of a rect or disc nearest to a point in its plane.
    vec3 AreaClamp(vec3 center, vec4 axis, vec4 tangent, float type, vec3 at) {
        vec3 local = at - center;
        vec3 bitangent = Math.Cross(axis.xyz, tangent.xyz);

        float u = Math.Dot(local, tangent.xyz);
        float vv = Math.Dot(local, bitangent);

        if (type > 3.5) {
            // Disc: clamp the offset's length.
            float radius = axis.w;
            float len = Math.Sqrt(u * u + vv * vv);
            float scale = Math.Min(len, radius) / Math.Max(len, 0.0001);
            u = u * scale;
            vv = vv * scale;
        } else {
            // Rect: clamp each axis to its half extent.
            u = Math.Clamp(u, -tangent.w, tangent.w);
            vv = Math.Clamp(vv, -axis.w, axis.w);
        }

        return center + tangent.xyz * u + bitangent * vv;
    }

    // The point on a panel that diffuse light is taken from. It follows the
    // surface and never the camera.
    // Halfway between straight across to the panel's plane and straight out
    // along the normal (Drobot, GPU Pro 5). The nearest point alone sits on the
    // horizon of a floor the panel stands on, and leaves that floor dark.
    vec3 AreaDiffusePoint(vec3 center, vec4 axis, vec4 tangent, float type, vec3 world, vec3 n, float height) {
        // Keeps the first ray above the surface and the second heading for the plane.
        float lean = 0.001 + Math.Clamp(Math.Dot(n, axis.xyz), 0.0, 1.0);
        vec3 across = Math.Normalize(n * lean - axis.xyz);
        vec3 along = Math.Normalize(n - axis.xyz * lean);
        vec3 ray = across + along;

        float approach = Math.Max(-Math.Dot(ray, axis.xyz), 0.0001);
        return AreaClamp(center, axis, tangent, type, world + ray * (height / approach));
    }

    // The point on a panel that the highlight is taken from: where the mirror
    // ray meets the panel's plane, pulled back onto the panel (Karis 2013).
    vec3 AreaSpecularPoint(vec3 center, vec4 axis, vec4 tangent, float type, vec3 world, vec3 n, vec3 v, float height) {
        vec3 r = Math.Reflect(-v, n);

        // A ray along the plane or away from it never meets it. The floor on
        // the divisor sends it far along the plane, onto the panel's far edge.
        // Falling back to the centre puts a seam in the highlight.
        float approach = Math.Max(-Math.Dot(r, axis.xyz), 0.0001);
        return AreaClamp(center, axis, tangent, type, world + r * (height / approach));
    }

    // Inverse-square falloff to one point of a panel, faded to zero at the range.
    float AreaFalloff(vec3 offset, vec3 facing, float range) {
        float distance = Math.Length(offset);
        float window = Math.Max(1.0 - distance / range, 0.0);

        // One-sided: a ceiling panel must not light the room above.
        float emitted = Math.Max(Math.Dot(facing, -offset) / Math.Max(distance, 0.0001), 0.0);

        return window * window / (1.0 + distance * distance) * emitted;
    }

    // A highlight that holds its peak across the whole panel carries more light
    // than the lamp has. Treat the lobe as widened by the panel's angular size
    // and scale by the ratio of the two peaks (Karis 2013).
    float AreaEnergy(vec3 center, vec4 axis, vec4 tangent, float type, vec3 world, float roughness) {
        float a = roughness * roughness;
        float reach = 0.5 / Math.Max(Math.Length(center - world), 0.0001);

        if (type > 3.5) {
            float disc = a / Math.Min(a + axis.w * reach, 1.0);
            return disc * disc;
        }

        return (a / Math.Min(a + tangent.w * reach, 1.0)) * (a / Math.Min(a + axis.w * reach, 1.0));
    }

    // Schlick's Fresnel.
    vec3 Fresnel(vec3 v, vec3 l, vec3 f0) {
        vec3 h = Math.Normalize(v + l);
        float vdoth = Math.Max(Math.Dot(v, h), 0.0);
        float weight = Math.Pow(1.0 - vdoth, 5.0);
        return f0 + (vec3(1.0, 1.0, 1.0) - f0) * weight;
    }

    // Lambert. Energy conservation: reflected light is not also diffused.
    vec3 DiffuseTerm(vec3 n, vec3 v, vec3 l, vec3 diffuseColor, vec3 f0) {
        float ndotl = Math.Max(Math.Dot(n, l), 0.0);
        if (ndotl <= 0.0) {
            return vec3(0.0, 0.0, 0.0);
        }

        vec3 kd = vec3(1.0, 1.0, 1.0) - Fresnel(v, l, f0);
        return kd * diffuseColor / 3.14159265 * ndotl;
    }

    // Cook-Torrance: GGX, Smith height-correlated visibility, Schlick Fresnel.
    vec3 SpecularTerm(vec3 n, vec3 v, vec3 l, vec3 f0, float roughness) {
        float ndotl = Math.Max(Math.Dot(n, l), 0.0);
        if (ndotl <= 0.0) {
            return vec3(0.0, 0.0, 0.0);
        }

        float ndotv = Math.Max(Math.Dot(n, v), 0.0001);
        vec3 h = Math.Normalize(v + l);
        float ndoth = Math.Max(Math.Dot(n, h), 0.0);

        // Perceptual roughness, squared (Disney).
        float a = roughness * roughness;
        float a2 = a * a;

        // GGX normal distribution.
        float denom = ndoth * ndoth * (a2 - 1.0) + 1.0;
        float d = a2 / Math.Max(3.14159265 * denom * denom, 0.0000001);

        // Height-correlated Smith visibility (Heitz 2014), already divided by
        // 4 (N.L)(N.V). Keep the two sqrts: Schlick's k approximation puts a
        // bright rim on smooth silhouettes.
        float lambdaV = ndotl * Math.Sqrt(ndotv * ndotv * (1.0 - a2) + a2);
        float lambdaL = ndotv * Math.Sqrt(ndotl * ndotl * (1.0 - a2) + a2);
        float vis = 0.5 / Math.Max(lambdaV + lambdaL, 0.0000001);

        return Fresnel(v, l, f0) * (d * vis) * ndotl;
    }

    // A rect or disc light. One point on the panel stands in for all of it,
    // and diffuse and specular each take their own. The specular point follows
    // the camera, so diffuse light taken from it slides across the wall as the
    // view turns.
    vec3 AreaLight(vec4 posRange, vec4 axis, vec4 tangent, float type, vec3 world, vec3 n, vec3 v, vec3 diffuseColor, vec3 f0, float roughness) {
        vec3 center = posRange.xyz;

        // How far in front of the panel. Nothing behind it is lit.
        float height = Math.Dot(world - center, axis.xyz);
        if (height <= 0.0) {
            return vec3(0.0, 0.0, 0.0);
        }

        vec3 toDiffuse = AreaDiffusePoint(center, axis, tangent, type, world, n, height) - world;
        vec3 toSpecular = AreaSpecularPoint(center, axis, tangent, type, world, n, v, height) - world;

        vec3 diffuse = DiffuseTerm(n, v, Math.Normalize(toDiffuse), diffuseColor, f0)
                     * AreaFalloff(toDiffuse, axis.xyz, posRange.w);
        vec3 specular = SpecularTerm(n, v, Math.Normalize(toSpecular), f0, roughness)
                      * AreaFalloff(toSpecular, axis.xyz, posRange.w)
                      * AreaEnergy(center, axis, tangent, type, world, roughness);

        return diffuse + specular;
    }

    // Clamp inside the cascade before the atlas offset, or a tap at the edge
    // reads the neighbouring cascade.
    float CompareTexel(vec2 texel, vec4 rect, float reference) {
        vec2 local = Math.Clamp(texel * uShadowTexel, vec2(0.0, 0.0), vec2(1.0, 1.0));
        return Math.Step(reference, uShadowMap.Sample(rect.xy + local * rect.z).r);
    }

    // Compare per texel, then blend the results. Blending depths first is wrong.
    float CompareBilinear(vec2 local, vec4 rect, float reference) {
        vec2 texels = local / uShadowTexel;
        vec2 corner = Math.Floor(texels - vec2(0.5, 0.5)) + vec2(0.5, 0.5);
        vec2 weight = texels - corner;

        float s00 = CompareTexel(corner + vec2(0.0, 0.0), rect, reference);
        float s10 = CompareTexel(corner + vec2(1.0, 0.0), rect, reference);
        float s01 = CompareTexel(corner + vec2(0.0, 1.0), rect, reference);
        float s11 = CompareTexel(corner + vec2(1.0, 1.0), rect, reference);

        return Math.Mix(Math.Mix(s00, s10, weight.x), Math.Mix(s01, s11, weight.x), weight.y);
    }

    // 1 fully lit, 0 fully shadowed.
    float ShadowFactor(vec3 world, vec2 pixel) {
        if (uShadowStrength <= 0.0) {
            return 1.0;
        }

        // First (sharpest) cascade containing the point. Past the last
        // cascade the point is lit.
        int chosen = -1;
        for (int k = 0; k < uCascadeCount; k = k + 1) {
            if (chosen < 0) {
                vec4 probe = uWorldToShadow[k] * vec4(world, 1.0);
                vec3 p = probe.xyz / probe.w;
                float inside = Math.Step(0.0, p.x) * Math.Step(p.x, 1.0)
                             * Math.Step(0.0, p.y) * Math.Step(p.y, 1.0)
                             * Math.Step(p.z, 1.0);
                if (inside > 0.0) {
                    chosen = k;
                }
            }
        }

        if (chosen < 0) {
            return 1.0;
        }

        vec4 rect = uCascadeRects[chosen];

        // No normal offset: it shifts the shadow sideways by a different
        // amount per face. The depth pass's slope-scaled raster bias handles acne.
        vec4 coords = uWorldToShadow[chosen] * vec4(world, 1.0);
        vec3 s = coords.xyz / coords.w;

        float reference = s.z - uShadowDepthBias;

        // Four bilinear taps on a circle, 16 fetches. Manual because
        // SpectraShade has no sampler2DShadow.
        // The circle is rotated per pixel: shadow edges are stored as a
        // texel staircase, and the rotation turns that regular comb into grain.
        // Snapped to the pixel's centre, so both paths spin a pixel the same way.
        vec2 cell = Math.Floor(pixel) + vec2(0.5, 0.5);
        float angle = 6.2831853 * Math.Fract(
            52.9829189 * Math.Fract(0.06711056 * cell.x + 0.00583715 * cell.y));
        vec2 spin = vec2(Math.Cos(angle), Math.Sin(angle)) * (uShadowFilterRadius * uShadowTexel);

        float sum = CompareBilinear(s.xy + vec2(spin.x, spin.y), rect, reference)
                  + CompareBilinear(s.xy + vec2(-spin.y, spin.x), rect, reference)
                  + CompareBilinear(s.xy + vec2(-spin.x, -spin.y), rect, reference)
                  + CompareBilinear(s.xy + vec2(spin.y, -spin.x), rect, reference);

        return Math.Mix(1.0, sum * 0.25, uShadowStrength);
    }

    // Ambient and every light, for one surface point. pixel is where the point
    // lands in the target. Only the shadow filter's dither reads it.
    vec3 Lighting(vec3 world, vec3 n, vec3 v, vec3 albedo, float surfaceRoughness, float metallic, float ao, vec2 pixel) {
        // Zero roughness makes the GGX denominator vanish.
        float roughness = Math.Max(surfaceRoughness, 0.04);

        // 4% reflectance for dielectrics; metals tint with albedo and have no diffuse.
        vec3 f0 = Math.Mix(vec3(0.04, 0.04, 0.04), albedo, metallic);
        vec3 diffuseColor = albedo * (1.0 - metallic);

        vec3 ambient = Math.Mix(uAmbientGround, uAmbientSky, n.y * 0.5 + 0.5);
        vec3 total = diffuseColor * ambient * uAmbient * ao;

        for (int i = 0; i < uLightCount; i = i + 1) {
            vec4 posRange = uLightPositions[i];
            vec4 colorType = uLightColors[i];
            vec4 axis = uLightAxis[i];
            vec4 tangent = uLightTangent[i];

            float type = colorType.w;
            vec3 lit = vec3(0.0, 0.0, 0.0);

            if (type > 2.5) {
                lit = AreaLight(posRange, axis, tangent, type, world, n, v, diffuseColor, f0, roughness);
            } else {
                // A directional light's position is the way it travels.
                vec3 l = -posRange.xyz;
                float attenuation = 1.0;

                if (type > 0.5) {
                    vec3 offset = posRange.xyz - world;
                    float distance = Math.Length(offset);
                    l = offset / Math.Max(distance, 0.0001);

                    // Inverse-square, faded to zero at the range. Squared so
                    // the edge does not show as a ring.
                    float window = Math.Max(1.0 - distance / posRange.w, 0.0);
                    attenuation = window * window / (1.0 + distance * distance);

                    if (type > 1.5) {
                        attenuation = attenuation * SpotFactor(axis, tangent, l);
                    }
                }

                l = Math.Normalize(l);
                lit = (DiffuseTerm(n, v, l, diffuseColor, f0) + SpecularTerm(n, v, l, f0, roughness)) * attenuation;
            }

            float shadow = 1.0;
            if (i == uShadowLightIndex) {
                shadow = ShadowFactor(world, pixel);
            }

            total = total + lit * colorType.rgb * shadow;
        }

        return total;
    }

    // Shared lighting ends.
}
