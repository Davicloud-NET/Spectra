// Unlit, per-vertex colour, for debug primitives. Vertices are already in
// world space, so there is no model matrix.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 color;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 color;
}

struct FragmentInput {
    vec3 color;
}

shader DebugLine {
    [Binding(0)] cbuffer Camera {
        mat4 uView;
        mat4 uProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = uProjection * uView * vec4(input.position, 1.0);
        output.color = input.color;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        return vec4(input.color, 1.0);
    }
}
