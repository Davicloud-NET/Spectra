// Depth-tested world lines for the forward and wireframe pipelines.
// WorldLineBlend is the deferred version and uses the same vertex nudge.
//
// The nudge: a grid at y = 0 on a floor at y = 0 is coplanar, and LessEqual
// alone leaves a stipple because the two depths interpolate an ulp apart.
// So each vertex moves toward the camera by a fraction of its distance. Done
// in world space so it is the same on every backend.
//
// The fade is per-pixel alpha from world distance to uFadeCenter. Drawn with
// blending on and depth write off.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 color;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 color;
    vec3 world;
}

struct FragmentInput {
    vec3 color;
    vec3 world;
}

shader WorldLine {
    [Binding(0)] cbuffer Camera {
        mat4 uView;
        mat4 uProjection;
        vec3 uCameraPosition;

        // Fraction of the distance to the camera.
        float uDepthNudge;

        // Full strength inside uFadeStart of uFadeCenter, gone at uFadeEnd,
        // (1-t)^2 between. A huge uFadeStart disables the fade.
        vec3 uFadeCenter;
        float uFadeStart;
        float uFadeEnd;

        // Alpha multiplier for every line.
        float uOpacity;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        vec3 nudged = input.position + (uCameraPosition - input.position) * uDepthNudge;
        output.position = uProjection * uView * vec4(nudged, 1.0);
        output.color = input.color;
        output.world = input.position;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        float t = Math.Clamp(
            (Math.Distance(input.world, uFadeCenter) - uFadeStart)
                / Math.Max(uFadeEnd - uFadeStart, 0.0001),
            0.0, 1.0);
        float falloff = (1.0 - t) * (1.0 - t);
        float alpha = falloff * uOpacity;

        if (alpha <= 0.004) {
            discard;
        }

        return vec4(input.color, alpha);
    }
}
