// World lines for the deferred pipeline: drawn after the light pass into the
// lit HDR target, alpha-blended.
//
// The depth test is done here, against the G-buffer depth sampled as a
// texture. The lit target has no usable depth of its own, and no backend can
// bind one target's colour with another's depth.
//
// Vertex stage is WorldLine's plus the clip position, which the fragment uses
// to find its G-buffer texel. The uv is snapped to a texel centre because the
// pass and the G-buffer can differ in size, as in DeferredLight.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 color;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 color;
    vec3 world;
    vec4 clip;
}

struct FragmentInput {
    vec3 color;
    vec3 world;
    vec4 clip;
}

shader WorldLineBlend {
    [Binding(0)] cbuffer Camera {
        mat4 uView;
        mat4 uProjection;
        vec3 uCameraPosition;

        // See WorldLine.spectrashade. Also the margin for the depth compare
        // below, which has no epsilon of its own.
        float uDepthNudge;

        // See WorldLine.spectrashade.
        vec3 uFadeCenter;
        float uFadeStart;
        float uFadeEnd;
        float uOpacity;

        // ndc.xy to uv, inverse of the light pass's uUvToNdc. Per backend
        // because of the V flip.
        vec4 uNdcToUv;

        // Depth texel to ndc z, same pair as the light pass.
        vec2 uDepthToNdc;

        // Size of the depth texture, not of this pass.
        vec2 uGBufferSize;
    }

    [Binding(0)] sampler2D uDepth;

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        vec3 nudged = input.position + (uCameraPosition - input.position) * uDepthNudge;
        vec4 clip = uProjection * uView * vec4(nudged, 1.0);
        output.position = clip;
        output.clip = clip;
        output.color = input.color;
        output.world = input.position;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec2 ndc = input.clip.xy / input.clip.w;
        vec2 uv = ndc * uNdcToUv.xy + uNdcToUv.zw;
        vec2 texel = Math.Floor(uv * uGBufferSize) + vec2(0.5, 0.5);
        vec2 snapped = texel / uGBufferSize;

        // Larger ndc z is farther on GL and D3D. A cleared texel is the far
        // plane, so sky passes.
        float stored = uDepth.Sample(snapped).r;
        float storedNdc = stored * uDepthToNdc.x + uDepthToNdc.y;
        float ownNdc = input.clip.z / input.clip.w;
        if (ownNdc > storedNdc) {
            discard;
        }

        float t = Math.Clamp(
            (Math.Distance(input.world, uFadeCenter) - uFadeStart)
                / Math.Max(uFadeEnd - uFadeStart, 0.0001),
            0.0, 1.0);
        float falloff = (1.0 - t) * (1.0 - t);
        float alpha = falloff * uOpacity;
        if (alpha <= 0.004) {
            discard;
        }

        return vec4(input.color, alpha);
    }
}
