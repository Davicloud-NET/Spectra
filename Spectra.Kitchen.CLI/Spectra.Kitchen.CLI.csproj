<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spectra.Kitchen.CLI</RootNamespace>
    <AssemblyName>scook</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <SignAssembly>false</SignAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spectra.Kitchen\Spectra.Kitchen.csproj" />
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />
    <!-- The check a cook asks before it packs a script. -->
    <ProjectReference Include="..\SpectraEngine.Scripting.Luau\SpectraEngine.Scripting.Luau.csproj" />
  </ItemGroup>

  <!-- Luau: copied beside a build, linked into a publish. -->
  <Import Project="..\native\Luau.targets" />

</Project>
