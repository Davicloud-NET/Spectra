<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Styles over Fluent's templates plus overrides of its resource keys. No full
    ControlThemes where a style will do.

    - Enter and exit share one duration. A faster exit would mean re-declaring
      Transitions inside :pointerover, and Avalonia doesn't guarantee the order
      setters revert in.
    - A transition goes on the part that changes. Button fills are set on the
      template's ContentPresenter, so the transition goes there too.
  -->

  <!-- Fluent key overrides. The tree row draws its own selection, so Fluent's
       is made transparent. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="TreeViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBorderBrushSelected" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemBorderBrushPointerOver" Color="Transparent" />
    <Thickness x:Key="TreeViewItemBorderThemeThickness">0</Thickness>
    <StaticResource x:Key="TreeViewItemMinHeight" ResourceKey="SpectraTreeRowHeight" />

    <!-- Fluent paints a selected ComboBoxItem with the system accent. These
         keys are what its template reads. -->
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="SpectraControlChecked" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="SpectraControlChecked" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="SpectraControlChecked" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SpectraControlHover" />
    <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="SpectraTextBody" />
    <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="SpectraTextEmphasis" />
    <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="SpectraTextEmphasis" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SpectraBgRaised" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="SpectraBorderStrong" />
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SpectraBgControl" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SpectraBgControlHover" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SpectraBgControl" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SpectraBorderControl" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="SpectraBorderControl" />
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="SpectraTextEmphasis" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="SpectraBorderControl" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="SpectraControlPressed" />

    <!-- Inside an open menu Fluent fills PART_LayoutRoot from these keys at
         trigger priority, which beats a style on the MenuItem itself. -->
    <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="SpectraControlHover" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="SpectraControlPressed" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent" />
    <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="SpectraTextBody" />
    <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SpectraTextEmphasis" />
    <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SpectraTextEmphasis" />
    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SpectraBgRaised" />

    <!-- Fluent's focused text box grows a 2px bottom border, a 1px layout
         shift on every focus. Keep it at 1. -->
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SpectraBgInput" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SpectraBgWindow" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SpectraBorderControl" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SpectraAccent" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource SpectraFontUi}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>

  <!-- Stretch None: Uniform scales each glyph to its own ink bounds and loses
       the shared 16 grid. -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <!-- Glyphs fill 69% of their box, so one shared scale for all of them.
         Stroke 1.3 lands at 1.56 after it. -->
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1.2)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Path.icon.kind-world">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushWorld}" />
  </Style>
  <Style Selector="Path.icon.kind-part">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushPart}" />
  </Style>
  <Style Selector="Path.icon.kind-cut">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushSubtractive}" />
  </Style>
  <Style Selector="Path.icon.kind-light">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindLight}" />
  </Style>
  <Style Selector="Path.icon.kind-entity">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindEntity}" />
  </Style>
  <Style Selector="Path.icon.kind-mesh">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindMesh}" />
  </Style>
  <Style Selector="Path.icon.kind-group">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindGroup}" />
  </Style>
  <!-- Disabled outranks the kind tint. -->
  <Style Selector="Button:disabled Path.icon.kind-world,
                   Button:disabled Path.icon.kind-part,
                   Button:disabled Path.icon.kind-cut,
                   Button:disabled Path.icon.kind-light">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Large icons are authored on their own 32 box, so no scale here.
       Stroke 1.6 matches the small set's effective 1.56. -->
  <Style Selector="Path.icon-lg">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Path.icon-lg.kind-world">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushWorld}" />
  </Style>
  <Style Selector="Path.icon-lg.kind-part">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushPart}" />
  </Style>
  <Style Selector="Path.icon-lg.kind-cut">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindBrushSubtractive}" />
  </Style>
  <Style Selector="Path.icon-lg.kind-light">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindLight}" />
  </Style>
  <Style Selector="Path.icon-lg.kind-entity">
    <Setter Property="Stroke" Value="{StaticResource SpectraKindEntity}" />
  </Style>
  <Style Selector="Button:disabled Path.icon-lg.kind-world,
                   Button:disabled Path.icon-lg.kind-part,
                   Button:disabled Path.icon-lg.kind-cut,
                   Button:disabled Path.icon-lg.kind-light,
                   Button:disabled Path.icon-lg.kind-entity">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <Style Selector="Button:disabled Path.icon-lg">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Check or radio mark. Rests at the mode amber with zero alpha so the
       transition only moves alpha. The dot is filled: stroked it is a ring. -->
  <Style Selector="Path.mark">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="#00E5A93F" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
        <BrushTransition Property="Fill"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Path.mark.dot">
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Fill" Value="#00E5A93F" />
  </Style>
  <Style Selector="Button.active Path.mark">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.active Path.mark.dot">
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Fill" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Path.markbox">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.active Path.markbox">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button:pointerover Path.markbox">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button:disabled Path.markbox">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Text roles. App-scoped: a floated panel leaves the main window's style
       scope. .value is a number, path or key name; .prose is a sentence. -->
  <Style Selector="TextBlock.value">
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.prose">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.sectionhead">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A unit, a count, a caption. Not a heading or a control label. -->
  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4,0" />
  </Style>

  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="{StaticResource SpectraControlHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource SpectraControlHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Menu > MenuItem:pointerover">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Menu > MenuItem:open">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusFloat}" />
    <!-- 4, not 3: at 3 a hovered first item's fill pokes into the rounded corner. -->
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="Menu MenuItem /template/ Popup > Border, ContextMenu MenuItem /template/ Popup > Border">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusFloat}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="ContextMenu MenuItem, Menu MenuItem MenuItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ContextMenu MenuItem:pointerover, Menu MenuItem MenuItem:pointerover">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="Margin" Value="24,0,2,0" />
  </Style>

  <!-- Menu glyphs: muted and unscaled, so the word stays the louder half. -->
  <Style Selector="Path.menuicon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
  </Style>
  <Style Selector="MenuItem:pointerover Path.menuicon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="MenuItem:disabled Path.menuicon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <Style Selector="ContextMenu Separator, Menu MenuItem Separator">
    <Setter Property="Background" Value="{StaticResource SpectraBorderSoft}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,3" />
  </Style>

  <!-- Raised capsule holding one group of command-bar controls. -->
  <Style Selector="Border.cluster">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Height" Value="{StaticResource SpectraControlHeight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Rule between segments of one cluster. -->
  <Style Selector="Border.segsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- Rule between clusters or runs of values. -->
  <Style Selector="Border.groupsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Background" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Segment buttons: flat inside their capsule. -->
  <Style Selector="Button.seg">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.seg /template/ ContentPresenter#PART_ContentPresenter">
      <!-- #00FFFFFF, not Transparent (transparent black): a fade to a
           translucent white would pass through grey. -->
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Button.seg:pointerover">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.seg:pointerover Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <!-- Labels need their own rule per state: the global TextBlock Foreground
       style beats the value inherited from the button. -->
  <Style Selector="Button.seg:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <!-- Lit state, in the mode colour. A class bound one way, not a ToggleButton:
       a toggle flips itself on click and the engine's snapshot then corrects
       it, which flickers. -->
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>
  <Style Selector="Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.seg.active Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.seg.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <Style Selector="Button.seg:disabled Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <Style Selector="Button.seg:disabled">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <!-- Must come after the hover and active rules so disabled wins. -->
  <Style Selector="Button.seg:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Standalone icon button, raised on its own. -->
  <Style Selector="Button.tool">
    <Setter Property="Width" Value="{StaticResource SpectraToolbarButtonSize}" />
    <Setter Property="Height" Value="{StaticResource SpectraToolbarButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
        <BrushTransition Property="BorderBrush"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
  </Style>
  <Style Selector="Button.tool:pointerover Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.tool.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.tool.active Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.tool:disabled Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Borderless icon button, for use inside a bordered container. -->
  <Style Selector="Button.ghost">
    <Setter Property="Width" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <!-- #00FFFFFF, not Transparent (transparent black): a fade to a
           translucent white would pass through grey. -->
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Button.ghost Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
  </Style>
  <Style Selector="Button.ghost:pointerover Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <!-- Mode chip: a two-way choice shown as subject plus current value. -->
  <Style Selector="Button.chip">
    <Setter Property="Height" Value="{StaticResource SpectraControlHeight}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
  </Style>
  <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
  </Style>
  <!-- A chip that opens a flyout wears a caret. Not part of the 16x16 icon
       set, so it is sized here and opts out of the icon scale. -->
  <Style Selector="Button.chip Path.chipcaret">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="1,1,0,0" />
  </Style>
  <Style Selector="Button.chip:pointerover Path.chipcaret">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.chip TextBlock.chipsubject">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip TextBlock.chipvalue">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip:disabled TextBlock.chipvalue">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <Style Selector="Button.chip:disabled TextBlock.chipsubject">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <Style Selector="Button.chip.nondefault TextBlock.chipvalue">
    <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
  </Style>

  <!-- Chip on a ribbon row. Must come after Button.chip to win on order. -->
  <Style Selector="Button.chip.compact">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="26" />
  </Style>

  <!-- Ribbon styles live here, not in Window.Styles: a collapsed ribbon shows
       its page in a popup, which has its own visual root. -->
  <Style Selector="Border.ribbonstrip">
    <Setter Property="Height" Value="{StaticResource SpectraMenuBarHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <!-- Active tab: raised surface plus a 2px accent underline, same as Dock's
       tabs. The resting border is the same 2px at zero alpha, so no layout shift. -->
  <Style Selector="Button.ribbontab">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ribbontab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00E8474A" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
        <BrushTransition Property="BorderBrush"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ribbontab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.ribbontab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Button.ribbontab:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.ribbontab.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
  </Style>
  <Style Selector="Button.ribbontab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
  </Style>
  <Style Selector="Button.ribbontab.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <!-- Pin chevron. TransformOperationsTransition, not TransformTransition,
       for a rotate() value. The Stroke transition is repeated because setting
       Transitions replaces the collection. -->
  <Style Selector="Button.ribbonpin">
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.ribbonpin Path.icon">
    <Setter Property="RenderTransform" Value="rotate(-90deg) scale(1.2)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="{StaticResource SpectraMotionFast}"
                                       Easing="{StaticResource SpectraEaseOut}" />
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ribbonpin.collapsed Path.icon">
    <Setter Property="RenderTransform" Value="rotate(90deg) scale(1.2)" />
  </Style>

  <!-- Ribbon page. No height animation: this row sizes the viewport, so a
       ramp would resize the swap chain every frame of it. -->
  <Style Selector="Border.ribbonbody">
    <Setter Property="Background" Value="{StaticResource SpectraRibbonBodyFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,5,8,3" />
  </Style>

  <!-- Ribbon group: content over a caption, no box. Border.ribbonrule sits
       between neighbours. -->
  <Style Selector="StackPanel.ribbongroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- MinHeight keeps every group's caption on one line. -->
  <Style Selector="StackPanel.rrow">
    <Setter Property="MinHeight" Value="66" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Column of small rows, three of 22 against a large button's 66.
       Centred, because a large button centres its own content. Columns of
       unequal length in one group use .ragged instead. -->
  <Style Selector="StackPanel.rcol">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>

  <Style Selector="StackPanel.rcol.ragged">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="TextBlock.ribbongroupcaption">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Ribbon controls: one large form and one small form.
       Gradients are only used by Border.sheen, Border.ribbonrule and
       Border.ribbonbody, and none of those transitions a brush.
       RibbonDepthConventionTests enforces it. -->

  <!-- Depth layer of a large button. Fades on opacity; the gradient swap on
       press is instant. -->
  <Style Selector="Border.sheen">
    <Setter Property="Background" Value="{StaticResource SpectraSheenRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBevelRaised}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity"
                          Duration="{StaticResource SpectraMotionFast}"
                          Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover Border.sheen">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.active Border.sheen">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button:pressed Border.sheen">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Background" Value="{StaticResource SpectraSheenSunken}" />
  </Style>
  <Style Selector="Button:disabled Border.sheen">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- Large button, 64 x 66: a 32px glyph over two lines of label. 64 is the
       narrowest that fits a ten-character word without a mid-word break.
       Not focusable: the tool keys go through the engine keymap, which only
       fires while the viewport has focus. Same for the other ribbon classes. -->
  <Style Selector="Button.rbig">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="66" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.rbig /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rbig:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.rbig:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Button.rbig.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>
  <Style Selector="Button.rbig.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>

  <Style Selector="Button.rbig StackPanel.rbigstack">
    <Setter Property="Margin" Value="2,3" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Two lines at most. RibbonLayout.LargeLabelLimit caps the label so
       MaxLines never eats a third. -->
  <Style Selector="Button.rbig TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="LineHeight" Value="13" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.rbig:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rbig:pointerover Path.icon-lg">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rbig.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rbig.active Path.icon-lg">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.rbig:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <!-- A press drops the content one pixel. -->
  <Style Selector="Button.rbig:pressed StackPanel.rbigstack">
    <Setter Property="Margin" Value="2,4,2,2" />
  </Style>

  <!-- Small row, 22px. Flat: a sheen would not show at this height. -->
  <Style Selector="Button.rsmall">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
  </Style>
  <Style Selector="Button.rsmall /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rsmall:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.rsmall:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Button.rsmall.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>
  <Style Selector="Button.rsmall.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlChecked}" />
  </Style>
  <Style Selector="Button.rsmall:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rsmall:pointerover Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rsmall.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rsmall.active Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="Button.rsmall:disabled TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
  </Style>
  <Style Selector="Button.rsmall:disabled Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- rtoggle, rcheck and rradio carry almost no styling. They exist so the
       ribbon validator can check a control wears the class its roster kind
       requires. Buttons, not CheckBox or RadioButton, for the same flicker
       reason as Button.seg. -->
  <Style Selector="Button.rtoggle">
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style Selector="Button.rsmall.rcheck">
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="Button.rsmall.rradio">
    <Setter Property="Padding" Value="2,0" />
  </Style>

  <!-- Stepper pair beside the snap field: two 11px halves of a 22px row. -->
  <Style Selector="Button.rspin">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="11" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rspin /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rspin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.rspin:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>
  <Style Selector="Path.spincaret">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Stroke"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rspin.up Path.spincaret">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>
  <Style Selector="Button.rspin:pointerover Path.spincaret">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.rspin:disabled Path.spincaret">
    <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
  </Style>

  <!-- Split button: an ordinary Button.rbig with a caret button beside it.
       The caret is beside, not under: a foot band puts the label 7px above
       its neighbours' and a hairline there cuts through the word. -->
  <Style Selector="StackPanel.rsplit">
    <Setter Property="Height" Value="66" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.rsplitcaret">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="66" />
    <!-- Explicit width: left to Stretch, the caret path draws from the left
         edge. Narrow because the Build page has little width to spare. -->
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rsplitcaret /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rsplitcaret:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
  </Style>
  <Style Selector="Button.rsplitcaret:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
  </Style>

  <!-- Divider between two ribbon groups. -->
  <Style Selector="Border.ribbonrule">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource SpectraGroupRule}" />
    <Setter Property="Margin" Value="2,1,2,18" />
  </Style>

  <!-- The ribbon page when shown in the collapsed ribbon's popup. -->
  <Style Selector="Border.ribbonflyout">
    <Setter Property="Background" Value="{StaticResource SpectraBgApp}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusFloat}" />
    <!-- Inline, the padding comes from Border.ribbonbody. -->
    <Setter Property="Padding" Value="10,6,10,6" />
  </Style>

  <!-- Text input: darker than the panel. Focus gets an accent border and a
       darker fill. -->
  <Style Selector="TextBox.field">
    <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{StaticResource SpectraAccentRest}" />
    <Setter Property="CaretBrush" Value="{StaticResource SpectraAccent}" />
  </Style>
  <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
    <!-- Only the border ramps. A fill fading under the caret reads as a repaint. -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource SpectraBgWindow}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
  </Style>
  <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
  </Style>

  <!-- Numeric cell: right-aligned so a column lines up on the decimal. -->
  <Style Selector="TextBox.field.num">
    <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="TextBox.field.num /template/ TextBlock#PART_Watermark">
    <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- Field on the ribbon's 22px row (the snap increment). App-scoped
       because it can end up in the ribbon's popup. -->
  <Style Selector="TextBox.field.inline">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <!-- Command palette. Wide enough for a name plus its chord on one line. -->
  <Style Selector="Border.palette">
    <Setter Property="Width" Value="520" />
    <Setter Property="Background" Value="{StaticResource SpectraBgApp}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusFloat}" />
    <Setter Property="Padding" Value="8" />
  </Style>
  <Style Selector="Border.palette TextBox.field">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="ListBox.palettelist">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.palettelist ListBoxItem">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
  </Style>

  <Style Selector="TextBlock.palettefoot">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="Margin" Value="8,4,8,2" />
  </Style>

  <!-- Set on the template part: Fluent paints item states on its own
       ContentPresenter at trigger priority. Same quiet fill as the scene tree. -->
  <Style Selector="ListBox.palettelist ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
  </Style>
  <Style Selector="ListBox.palettelist ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
  </Style>
  <Style Selector="ListBox.palettelist ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
  </Style>
  <Style Selector="ListBox.palettelist ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="ListBox.palettelist ListBoxItem:selected TextBlock.palettechord">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
  </Style>

  <Style Selector="TextBlock.palettechord">
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>

  <!-- Checkbox. Fluent's stock box is 20px, too tall for a 24px inspector row. -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Repeated per state: the rule above loses to Fluent's :pointerover and
       :pressed part triggers. -->
  <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
  </Style>
  <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
  </Style>
  <!-- A ticked box is state, not selection, so it is amber like the ribbon's
       checks and never the accent. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
  </Style>
  <Style Selector="CheckBox /template/ Path#CheckGlyph">
    <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
    <Setter Property="Fill" Value="{StaticResource SpectraMode}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="MinHeight" Value="{StaticResource SpectraFieldHeight}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
  </Style>

  <!-- The one filled-accent button. Rests on SpectraAccentRest: white on the
       brighter accent fails AA. -->
  <Style Selector="Button.primary">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraAccentRest}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <!-- String content becomes a TextBlock, which the global TextBlock style
       would paint body grey. -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraAccentRest}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
        <BrushTransition Property="BorderBrush"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>
  <Style Selector="Button.secondary:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#24FFFFFF" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="#3AFFFFFF" />
  </Style>
  <!-- Without this Fluent's :pressed trigger wins mid-drag. -->
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="#50FFFFFF" />
  </Style>

  <!-- Splitter: hit area wider than its ink. The transparent fill is set here,
       not inline on the control, because a local value outranks style
       triggers. The visible line is a separate 1px child. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <!-- .hot is set from the splitter's pointer and drag events in code: a
       child can't select on its parent's pseudo-classes. -->
  <Style Selector="Border.splitink">
    <Setter Property="Background" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background"
                         Duration="{StaticResource SpectraMotionFast}"
                         Easing="{StaticResource SpectraEaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.splitink.hot">
    <Setter Property="Background" Value="{StaticResource SpectraAccent}" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{StaticResource SpectraTreeRowHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Focus ring in the accent, replacing Fluent's white rectangle. -->
  <Style Selector="TreeViewItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource SpectraAccent}"
                BorderThickness="1"
                CornerRadius="{StaticResource SpectraRadiusControl}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="Button">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{StaticResource SpectraAccent}"
                BorderThickness="1"
                CornerRadius="{StaticResource SpectraRadiusControl}"
                Margin="-1" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- No ring on a segment: it would sit one pixel inside the capsule's border. -->
  <Style Selector="Button.seg">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusFloat}" />
    <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="Padding" Value="9,6" />
  </Style>

</Styles>
