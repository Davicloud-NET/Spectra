<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:ease="using:Avalonia.Animation.Easings">

  <!--
    All of the shell's colours, sizes, radii and durations. No literals elsewhere.

    - Borders and lines are solid hex. An alpha hairline changes colour over
      each surface it crosses. Alpha is for hover fills only.
    - Text colour is a colour, not an opacity on white: that breaks Windows
      subpixel rendering.
    - Things you press are a step lighter than their surface and outlined dark.
      Things you type into are darker than it and outlined light.
    - A resting control never gets a light outline: that is what hover looks like.
    - No gradients. The colour picker ramps are the only ones.
    - Brushes are solid brushes over a DynamicResource colour, so a theme swap
      re-tints them in place and consumers can keep StaticResource.
  -->

  <!-- Surfaces, darkest first. Window is the ground that shows in the gaps
       between panels. Raised is header bands and popups. -->
  <Color x:Key="SpectraBgWindowColor">#0D0E10</Color>
  <Color x:Key="SpectraBgAppColor">#0D0E10</Color>
  <Color x:Key="SpectraBgPanelColor">#202226</Color>
  <Color x:Key="SpectraBgRibbonColor">#26292E</Color>
  <Color x:Key="SpectraBgRaisedColor">#2B2E33</Color>

  <SolidColorBrush x:Key="SpectraBgWindow" Color="{DynamicResource SpectraBgWindowColor}" />
  <SolidColorBrush x:Key="SpectraBgApp" Color="{DynamicResource SpectraBgAppColor}" />
  <SolidColorBrush x:Key="SpectraBgPanel" Color="{DynamicResource SpectraBgPanelColor}" />
  <SolidColorBrush x:Key="SpectraBgRibbon" Color="{DynamicResource SpectraBgRibbonColor}" />
  <SolidColorBrush x:Key="SpectraBgRaised" Color="{DynamicResource SpectraBgRaisedColor}" />

  <!-- A key at rest, hovered and pressed, and the well a field sits in. -->
  <Color x:Key="SpectraBgControlColor">#2B2E34</Color>
  <Color x:Key="SpectraBgControlHoverColor">#383C43</Color>
  <Color x:Key="SpectraBgControlActiveColor">#1C1E22</Color>
  <Color x:Key="SpectraBgInputColor">#101113</Color>

  <SolidColorBrush x:Key="SpectraBgControl" Color="{DynamicResource SpectraBgControlColor}" />
  <SolidColorBrush x:Key="SpectraBgControlHover" Color="{DynamicResource SpectraBgControlHoverColor}" />
  <SolidColorBrush x:Key="SpectraBgControlActive" Color="{DynamicResource SpectraBgControlActiveColor}" />
  <SolidColorBrush x:Key="SpectraBgInput" Color="{DynamicResource SpectraBgInputColor}" />

  <!-- Soft: rules between rows. Strong: a panel outline. Control: the dark
       seam round a key. Input: the light edge of a well. RibbonRule: the
       divider between ribbon groups, light so it differs from the seams. -->
  <Color x:Key="SpectraBorderSoftColor">#16171A</Color>
  <Color x:Key="SpectraBorderStrongColor">#363A40</Color>
  <Color x:Key="SpectraBorderControlColor">#121316</Color>
  <Color x:Key="SpectraBorderInputColor">#444951</Color>
  <Color x:Key="SpectraBorderInputHoverColor">#5A606A</Color>
  <Color x:Key="SpectraRibbonRuleColor">#4A4F58</Color>

  <SolidColorBrush x:Key="SpectraBorderSoft" Color="{DynamicResource SpectraBorderSoftColor}" />
  <SolidColorBrush x:Key="SpectraBorderStrong" Color="{DynamicResource SpectraBorderStrongColor}" />
  <SolidColorBrush x:Key="SpectraBorderControl" Color="{DynamicResource SpectraBorderControlColor}" />
  <SolidColorBrush x:Key="SpectraBorderInput" Color="{DynamicResource SpectraBorderInputColor}" />
  <SolidColorBrush x:Key="SpectraBorderInputHover" Color="{DynamicResource SpectraBorderInputHoverColor}" />
  <SolidColorBrush x:Key="SpectraRibbonRule" Color="{DynamicResource SpectraRibbonRuleColor}" />

  <!-- Frame between the chrome and the render. -->
  <SolidColorBrush x:Key="SpectraViewportBezel" Color="{DynamicResource SpectraBgWindowColor}" />

  <!-- Text. Muted carries captions on the ribbon and on header bands, so it
       has to pass AA there too, not only on the panel.
       Disabled also draws filter-dimmed tree rows, so it must stay visible. -->
  <Color x:Key="SpectraTextEmphasisColor">#E9EAEC</Color>
  <Color x:Key="SpectraTextBodyColor">#BDC0C5</Color>
  <Color x:Key="SpectraTextMutedColor">#979BA4</Color>
  <Color x:Key="SpectraTextDisabledColor">#646870</Color>
  <!-- Text and glyphs on an accent or play fill. -->
  <Color x:Key="SpectraTextOnAccentColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="SpectraTextEmphasis" Color="{DynamicResource SpectraTextEmphasisColor}" />
  <SolidColorBrush x:Key="SpectraTextBody" Color="{DynamicResource SpectraTextBodyColor}" />
  <SolidColorBrush x:Key="SpectraTextMuted" Color="{DynamicResource SpectraTextMutedColor}" />
  <SolidColorBrush x:Key="SpectraTextDisabled" Color="{DynamicResource SpectraTextDisabledColor}" />
  <SolidColorBrush x:Key="SpectraTextOnAccent" Color="{DynamicResource SpectraTextOnAccentColor}" />

  <!-- Accent means selected or switched on: a selected row, the live tool,
       a ticked box, focus, the primary button. Never a panel fill.
       AccentRest is the fill under white text: white on #3D7EF0 is 3.9:1 and
       fails AA. -->
  <Color x:Key="SpectraAccentColor">#3D7EF0</Color>
  <Color x:Key="SpectraAccentRestColor">#2F6DE0</Color>
  <Color x:Key="SpectraTextDangerColor">#FF6E6B</Color>

  <SolidColorBrush x:Key="SpectraAccent" Color="{DynamicResource SpectraAccentColor}" />
  <SolidColorBrush x:Key="SpectraAccentRest" Color="{DynamicResource SpectraAccentRestColor}" />
  <SolidColorBrush x:Key="SpectraTextDanger" Color="{DynamicResource SpectraTextDangerColor}" />

  <!-- A refused field gets a border, not a fill. A fill reads as selection. -->
  <SolidColorBrush x:Key="SpectraBorderDanger" Color="{DynamicResource SpectraTextDangerColor}" />

  <!-- Mode means "look here": play mode, a latched overlay, the dirty dot, a
       chip showing a non-default value, a drop target.
       Warning shares the colour on purpose; its icon and place tell it apart. -->
  <Color x:Key="SpectraModeColor">#E5A93F</Color>
  <SolidColorBrush x:Key="SpectraMode" Color="{DynamicResource SpectraModeColor}" />
  <SolidColorBrush x:Key="SpectraWarning" Color="{DynamicResource SpectraModeColor}" />

  <!-- PlayFill is the Play button, dark enough for white text. -->
  <Color x:Key="SpectraSuccessColor">#5DBE7A</Color>
  <Color x:Key="SpectraPlayFillColor">#27804D</Color>
  <Color x:Key="SpectraPlayFillHoverColor">#2E9259</Color>
  <Color x:Key="SpectraInfoColor">#6E9FDE</Color>
  <SolidColorBrush x:Key="SpectraSuccess" Color="{DynamicResource SpectraSuccessColor}" />
  <SolidColorBrush x:Key="SpectraInfo" Color="{DynamicResource SpectraInfoColor}" />
  <SolidColorBrush x:Key="SpectraPlayFill" Color="{DynamicResource SpectraPlayFillColor}" />
  <SolidColorBrush x:Key="SpectraPlayFillHover" Color="{DynamicResource SpectraPlayFillHoverColor}" />

  <!-- Fluent takes SystemAccentColor from Windows personalisation, so any stock
       control we haven't restyled would use the user's taskbar colour.
       The six shades have no references in this repo. Fluent's templates read
       them; don't delete them as dead. -->
  <Color x:Key="SystemAccentColor">#2F6DE0</Color>
  <Color x:Key="SystemAccentColorDark1">#2960C8</Color>
  <Color x:Key="SystemAccentColorDark2">#214D9F</Color>
  <Color x:Key="SystemAccentColorDark3">#193A78</Color>
  <Color x:Key="SystemAccentColorLight1">#3D7EF0</Color>
  <Color x:Key="SystemAccentColorLight2">#6497F3</Color>
  <Color x:Key="SystemAccentColorLight3">#8BB1F6</Color>

  <!-- Transient fills. Alpha goes in the colour, never on the brush opacity:
       a brush transition interpolates colour and opacity separately and the
       renderer multiplies them, so a fade in overshoots to about 3.5x the fill.
       The two washes repeat their hue as a literal. Change them together with
       SpectraAccentColor and SpectraModeColor. -->
  <Color x:Key="SpectraAccentWashColor">#383D7EF0</Color>
  <Color x:Key="SpectraModeWashColor">#38E5A93F</Color>

  <!-- Colour picker ramps. Not palette values; a theme swap leaves them alone.
       The saturation ramp ends on transparent white. Transparent is transparent
       black and would grey the ramp. -->
  <LinearGradientBrush x:Key="SpectraHueRamp" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#FFFF0000" />
    <GradientStop Offset="0.1667" Color="#FFFFFF00" />
    <GradientStop Offset="0.3333" Color="#FF00FF00" />
    <GradientStop Offset="0.5" Color="#FF00FFFF" />
    <GradientStop Offset="0.6667" Color="#FF0000FF" />
    <GradientStop Offset="0.8333" Color="#FFFF00FF" />
    <GradientStop Offset="1" Color="#FFFF0000" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SpectraSaturationRamp" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#FFFFFFFF" />
    <GradientStop Offset="1" Color="#00FFFFFF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SpectraValueRamp" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#00000000" />
    <GradientStop Offset="1" Color="#FF000000" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="SpectraRowHover" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SpectraRowSelected" Color="{DynamicResource SpectraAccentRestColor}" />
  <!-- Every other row of a list, so rows read as separate strips. -->
  <SolidColorBrush x:Key="SpectraRowAlternate" Color="#07FFFFFF" />
  <SolidColorBrush x:Key="SpectraControlHover" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SpectraControlPressed" Color="#21FFFFFF" />
  <SolidColorBrush x:Key="SpectraControlChecked" Color="{DynamicResource SpectraAccentRestColor}" />
  <SolidColorBrush x:Key="SpectraModeWash" Color="{DynamicResource SpectraModeWashColor}" />

  <!-- Drop-target wash over the viewport. A third of SpectraControlChecked's
       alpha: over the whole render the chip's alpha would be a colour cast. -->
  <Color x:Key="SpectraDropWashColor">#12E5A93F</Color>
  <SolidColorBrush x:Key="SpectraDropWash" Color="{DynamicResource SpectraDropWashColor}" />

  <!-- Axis colours: the gizmo handles' hues (GizmoColors), desaturated. -->
  <SolidColorBrush x:Key="SpectraAxisX" Color="#F0706A" />
  <SolidColorBrush x:Key="SpectraAxisY" Color="#7CCB6E" />
  <SolidColorBrush x:Key="SpectraAxisZ" Color="#6FA4F2" />

  <!-- Node-kind tints. Saturated only for kinds that draw nothing in the
       viewport or need finding fast: light, subtractive brush, entity. -->
  <SolidColorBrush x:Key="SpectraKindGroup" Color="#979BA4" />
  <SolidColorBrush x:Key="SpectraKindMesh" Color="#C3C6CB" />
  <SolidColorBrush x:Key="SpectraKindBrushWorld" Color="#7FB4FF" />
  <SolidColorBrush x:Key="SpectraKindBrushPart" Color="#6FD3B8" />
  <SolidColorBrush x:Key="SpectraKindBrushSubtractive" Color="#E58BD8" />
  <SolidColorBrush x:Key="SpectraKindLight" Color="#F2C75C" />
  <SolidColorBrush x:Key="SpectraKindEntity" Color="#B9A5FF" />

  <!-- The Logic view's graph. Ground is the page the cards stand on, between
       the window and the panel. CardHead carries the muted class line, so it
       is as light as that text allows. Stub is the card of a name nothing
       has; StubEdge outlines a label that reports a miss. -->
  <Color x:Key="SpectraLogicGroundColor">#1B1D20</Color>
  <Color x:Key="SpectraLogicGridDotColor">#2A2D32</Color>
  <Color x:Key="SpectraLogicCardColor">#282B30</Color>
  <Color x:Key="SpectraLogicCardHeadColor">#2E3238</Color>
  <Color x:Key="SpectraLogicStubColor">#2A2224</Color>
  <Color x:Key="SpectraLogicStubHeadColor">#33272A</Color>
  <Color x:Key="SpectraLogicStubTextColor">#D98C87</Color>
  <Color x:Key="SpectraLogicStubEdgeColor">#5A3434</Color>

  <SolidColorBrush x:Key="SpectraLogicGround" Color="{DynamicResource SpectraLogicGroundColor}" />
  <SolidColorBrush x:Key="SpectraLogicGridDot" Color="{DynamicResource SpectraLogicGridDotColor}" />
  <SolidColorBrush x:Key="SpectraLogicCard" Color="{DynamicResource SpectraLogicCardColor}" />
  <SolidColorBrush x:Key="SpectraLogicCardHead" Color="{DynamicResource SpectraLogicCardHeadColor}" />
  <SolidColorBrush x:Key="SpectraLogicStub" Color="{DynamicResource SpectraLogicStubColor}" />
  <SolidColorBrush x:Key="SpectraLogicStubHead" Color="{DynamicResource SpectraLogicStubHeadColor}" />
  <SolidColorBrush x:Key="SpectraLogicStubText" Color="{DynamicResource SpectraLogicStubTextColor}" />
  <SolidColorBrush x:Key="SpectraLogicStubEdge" Color="{DynamicResource SpectraLogicStubEdgeColor}" />

  <!-- A wire at rest, one that fired a moment ago, and one that fired
       earlier. A selected wire is the accent and a broken one the danger
       colour. -->
  <Color x:Key="SpectraLogicWireColor">#666B74</Color>
  <Color x:Key="SpectraLogicWireFiringColor">#7FB4FF</Color>
  <Color x:Key="SpectraLogicWireFiredColor">#56719A</Color>

  <SolidColorBrush x:Key="SpectraLogicWire" Color="{DynamicResource SpectraLogicWireColor}" />
  <SolidColorBrush x:Key="SpectraLogicWireFiring" Color="{DynamicResource SpectraLogicWireFiringColor}" />
  <SolidColorBrush x:Key="SpectraLogicWireFired" Color="{DynamicResource SpectraLogicWireFiredColor}" />

  <!-- Laid over what the filter leaves out, which leaves three tenths of it.
       It repeats the ground as a literal. Change it with SpectraLogicGroundColor. -->
  <Color x:Key="SpectraLogicDimWashColor">#B31B1D20</Color>
  <SolidColorBrush x:Key="SpectraLogicDimWash" Color="{DynamicResource SpectraLogicDimWashColor}" />

  <!-- How the graph is drawn, in pixels at 100 percent. Where things stand
       is LogicMetrics, in code. A wire's dash and gap are lengths along it. -->
  <x:Double x:Key="SpectraLogicCardRadius">6</x:Double>
  <x:Double x:Key="SpectraLogicSelectedEdge">2</x:Double>
  <x:Double x:Key="SpectraLogicStubDash">4</x:Double>
  <x:Double x:Key="SpectraLogicIconStroke">1.25</x:Double>
  <x:Double x:Key="SpectraLogicFarNameSize">26</x:Double>
  <x:Double x:Key="SpectraLogicDotRadius">4.5</x:Double>
  <x:Double x:Key="SpectraLogicTravelDotRadius">5.5</x:Double>
  <x:Double x:Key="SpectraLogicTravelDotEdge">2</x:Double>
  <x:Double x:Key="SpectraLogicWireWidth">1.6</x:Double>
  <x:Double x:Key="SpectraLogicWireFocusWidth">2</x:Double>
  <x:Double x:Key="SpectraLogicWireFiringWidth">2.6</x:Double>
  <x:Double x:Key="SpectraLogicWireFiredWidth">1.8</x:Double>
  <x:Double x:Key="SpectraLogicWireBrokenDash">6</x:Double>
  <x:Double x:Key="SpectraLogicWireBrokenGap">5</x:Double>
  <x:Double x:Key="SpectraLogicWireWaitingDash">2</x:Double>
  <x:Double x:Key="SpectraLogicWireWaitingGap">6</x:Double>
  <x:Double x:Key="SpectraLogicHoverGlow">5</x:Double>
  <x:Double x:Key="SpectraLogicGridStep">24</x:Double>
  <x:Double x:Key="SpectraLogicGridDotSize">2</x:Double>

  <!-- The rows round the graph. The event strip is three rows, its padding
       and the rule above it. -->
  <x:Double x:Key="SpectraLogicToolbarHeight">36</x:Double>
  <x:Double x:Key="SpectraLogicEventRowHeight">19</x:Double>
  <x:Double x:Key="SpectraLogicEventStripHeight">64</x:Double>
  <x:Double x:Key="SpectraLogicPillHeight">22</x:Double>
  <x:Double x:Key="SpectraLogicPillDot">7</x:Double>
  <CornerRadius x:Key="SpectraLogicPillRadius">11</CornerRadius>

  <!-- Fonts. $Default is Avalonia's fallback; CSS generics like "monospace"
       resolve to nothing.
       Mono is for values (numbers, paths, key names), set 1px smaller than the
       sans next to it. -->
  <FontFamily x:Key="SpectraFontUi">avares://SpectraEngine.Editor/Assets/Fonts#IBM Plex Sans, Segoe UI Variable Text, Segoe UI, $Default</FontFamily>
  <FontFamily x:Key="SpectraFontMono">avares://SpectraEngine.Editor/Assets/Fonts#IBM Plex Mono, Cascadia Mono, Consolas, $Default</FontFamily>

  <!-- Type scale, base 12. No 700 weight at this size on dark: it blooms.
       Micro is for tertiary labels, not section headings. -->
  <x:Double x:Key="SpectraFontMicro">10</x:Double>
  <x:Double x:Key="SpectraFontSmall">11</x:Double>
  <x:Double x:Key="SpectraFontSecondary">12</x:Double>
  <x:Double x:Key="SpectraFontBase">12</x:Double>
  <x:Double x:Key="SpectraFontTitle">14</x:Double>
  <x:Double x:Key="SpectraFontDisplay">16</x:Double>

  <!-- Fixed heights, not padding-derived, so rows stack cleanly at 125% and
       150% DPI. -->
  <x:Double x:Key="SpectraTreeRowHeight">24</x:Double>
  <x:Double x:Key="SpectraFieldHeight">24</x:Double>
  <x:Double x:Key="SpectraControlHeight">28</x:Double>
  <x:Double x:Key="SpectraToolbarButtonSize">28</x:Double>
  <x:Double x:Key="SpectraMenuBarHeight">36</x:Double>
  <x:Double x:Key="SpectraToolbarHeight">40</x:Double>
  <x:Double x:Key="SpectraStatusBarHeight">26</x:Double>

  <!-- Radii. Tile is a panel or the ribbon; Float is a popup. -->
  <CornerRadius x:Key="SpectraRadiusControl">4</CornerRadius>
  <CornerRadius x:Key="SpectraRadiusFloat">7</CornerRadius>
  <CornerRadius x:Key="SpectraRadiusTile">7</CornerRadius>
  <CornerRadius x:Key="SpectraRadiusTray">5</CornerRadius>

  <!-- Motion. Interaction transitions are 130ms at most. Only the view swap
       and the reveal scroll may run longer. No overshoot easings (Back, Bounce,
       Elastic), nothing loops.
       Nothing a pointer writes every frame gets a transition, or it trails the
       cursor by the duration: drop indicators, value cells, status readouts,
       the rename box. -->
  <ease:CubicEaseOut x:Key="SpectraEaseOut" />
  <ease:CubicEaseInOut x:Key="SpectraEaseInOut" />

  <sys:TimeSpan x:Key="SpectraMotionExit">00:00:00.0550000</sys:TimeSpan>
  <sys:TimeSpan x:Key="SpectraMotionFast">00:00:00.0600000</sys:TimeSpan>
  <sys:TimeSpan x:Key="SpectraMotionBase">00:00:00.1000000</sys:TimeSpan>
  <sys:TimeSpan x:Key="SpectraMotionSwap">00:00:00.1900000</sys:TimeSpan>

</ResourceDictionary>
