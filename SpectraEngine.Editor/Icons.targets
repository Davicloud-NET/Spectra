<Project>

  <!--
    Generates Theme/Icons.axaml from Assets/Icons/*.svg and from the world
    icons in SpectraEngine.Editing/Assets/Icons/*.svg, one resource per file,
    keyed by file name.

    Path data is copied as written, but for a relative move that opens a path:
    the paths of a file are joined, so that move is made absolute. Scaling a
    'd' string means handling arcs, relative commands and flags, so
    width/height against the viewBox becomes a Transform instead. A 24-box
    glyph drops in with width="16" height="16".

    PathGeometry, not StreamGeometry: a StreamGeometry takes its data as element
    content and cannot also carry a Transform attribute.
  -->

  <UsingTask TaskName="GenerateIconResources"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Icons ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // REGEX RATHER THAN AN XML PARSER, because a RoslynCodeTaskFactory task
        // cannot reference System.Xml.Linq on this SDK ("Could not find
        // reference System.Xml.Linq"). The shapes matched here are the ones an
        // icon file guarantees: one svg element carrying a viewBox, and paths
        // carrying a d.
        var svgTag = new Regex(@"<svg\b[^>]*>", RegexOptions.IgnoreCase | RegexOptions.Singleline);
        var attrs = new Regex(@"(?<n>viewBox|width|height)\s*=\s*""(?<v>[^""]*)""", RegexOptions.IgnoreCase);
        var paths = new Regex(@"<path\b[^>]*?\bd\s*=\s*""(?<d>[^""]*)""", RegexOptions.IgnoreCase | RegexOptions.Singleline);

        // A length may carry a unit ("16px"); the viewBox is the fallback,
        // which makes width and height optional exactly as SVG does.
        Func<string, double, double> Length = (raw, fallback) =>
        {
            if (string.IsNullOrWhiteSpace(raw)) { return fallback; }
            string digits = new string(raw.Trim().TakeWhile(c => char.IsDigit(c) || c == '.' || c == '-').ToArray());
            double parsed;
            return double.TryParse(digits, NumberStyles.Float, CultureInfo.InvariantCulture, out parsed) && parsed > 0
                ? parsed
                : fallback;
        };

        Func<double, string> N = v => Math.Round(v, 5).ToString("0.#####", CultureInfo.InvariantCulture);

        // A path that opens with a relative move starts from 0 0, and the 3D
        // view reads it so. Joined after another path it would start where
        // that one ended, so the move is written as absolute. Numbers after a
        // move are lines, and those stay relative.
        string number = @"[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?";
        var leadingMove = new Regex(@"^m[\s,]*(?<x>" + number + @")[\s,]*(?<y>" + number + @")[\s,]*(?<more>(?=[-+.\d]))?");
        MatchEvaluator Absolute = m =>
            "M" + m.Groups["x"].Value + " " + m.Groups["y"].Value + (m.Groups["more"].Success ? " l " : " ");

        var rows = new List<string>();
        var seen = new HashSet<string>(StringComparer.Ordinal);

        // Ordinal by key, so the emitted file does not depend on the order the
        // filesystem happened to enumerate in. The artifact has to be
        // byte-stable, or every build dirties a tracked file.
        foreach (ITaskItem item in Icons.OrderBy(i => Path.GetFileNameWithoutExtension(i.ItemSpec), StringComparer.Ordinal))
        {
            string key = Path.GetFileNameWithoutExtension(item.ItemSpec);

            // Two folders feed this. One key in both would be two drawings of one thing.
            if (!seen.Add(key))
            {
                Log.LogError("Icons: '{0}' is in both icon folders. Keep one file.", key);
                continue;
            }

            string svg = File.ReadAllText(item.ItemSpec);

            Match tag = svgTag.Match(svg);
            if (!tag.Success)
            {
                Log.LogError("Icons: '{0}' has no svg element.", item.ItemSpec);
                continue;
            }

            string viewBox = null, widthRaw = null, heightRaw = null;
            foreach (Match a in attrs.Matches(tag.Value))
            {
                string n = a.Groups["n"].Value.ToLowerInvariant();
                if (n == "viewbox") { viewBox = a.Groups["v"].Value; }
                else if (n == "width") { widthRaw = a.Groups["v"].Value; }
                else if (n == "height") { heightRaw = a.Groups["v"].Value; }
            }

            double[] view = (viewBox ?? string.Empty)
                .Split(new[] { ' ', ',', '\t', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(v => double.Parse(v, CultureInfo.InvariantCulture))
                .ToArray();
            if (view.Length != 4 || view[2] <= 0 || view[3] <= 0)
            {
                Log.LogError("Icons: '{0}' needs a viewBox of four numbers with a positive width and height.", item.ItemSpec);
                continue;
            }

            string[] data = paths.Matches(svg).Cast<Match>()
                .Select(m => m.Groups["d"].Value.Trim())
                .Where(d => d.Length > 0)
                .ToArray();
            if (data.Length == 0)
            {
                Log.LogError("Icons: '{0}' declares no path with a d attribute; only path geometry is supported.", item.ItemSpec);
                continue;
            }

            // Joined to the path before it, such a path would draw on as more
            // of that one. The 3D view gives the file no glyph.
            if (data.Any(d => d[0] != 'M' && d[0] != 'm'))
            {
                Log.LogError("Icons: '{0}' has a path that draws before it moves. Path data starts with M.", item.ItemSpec);
                continue;
            }

            string figures = string.Join(" ", data.Select(d => leadingMove.Replace(d, Absolute)));

            double width = Length(widthRaw, view[2]);
            double height = Length(heightRaw, view[3]);

            // Uniform, so a replacement whose aspect differs is letterboxed
            // rather than stretched: a squashed glyph is the kind of wrong that
            // still looks deliberate.
            double scale = Math.Min(width / view[2], height / view[3]);
            double dx = ((width - (view[2] * scale)) / 2) - (view[0] * scale);
            double dy = ((height - (view[3] * scale)) / 2) - (view[1] * scale);

            // A MATRIX, NOT "scale(0.5)". Avalonia's Transform converter is
            // Matrix.Parse, which wants six numbers; a CSS-shaped function
            // compiles perfectly and throws System.FormatException "Invalid
            // Matrix" when the resource is first USED - so it survives a build,
            // survives every icon that needs no transform, and fails the day
            // somebody drops in a glyph on a different viewBox. Which is to say
            // it fails for the one person this whole mechanism is for.
            bool identity = Math.Abs(scale - 1) <= 1e-9 && Math.Abs(dx) <= 1e-9 && Math.Abs(dy) <= 1e-9;
            string transformAttr = identity
                ? string.Empty
                : " Transform=\"" + N(scale) + ",0,0," + N(scale) + "," + N(dx) + "," + N(dy) + "\"";

            rows.Add("  <PathGeometry x:Key=\"" + key + "\" Figures=\"" +
                     figures.Replace("&", "&amp;").Replace("\"", "&quot;").Replace("<", "&lt;") +
                     "\"" + transformAttr + " />");
        }

        var text = new StringBuilder();
        text.Append("<!--\n");
        text.Append("  GENERATED FROM Assets/Icons/*.svg AND SpectraEngine.Editing/Assets/Icons/*.svg\n");
        text.Append("  BY Icons.targets. DO NOT EDIT.\n\n");
        text.Append("  Change a glyph by replacing its .svg and rebuilding. Each Figures below\n");
        text.Append("  is its file's own path data, joined. A relative move that opens a path\n");
        text.Append("  is written as absolute, and the viewBox to width/height mapping is a\n");
        text.Append("  Transform.\n");
        text.Append("-->\n");
        text.Append("<ResourceDictionary xmlns=\"https://github.com/avaloniaui\"\n");
        text.Append("                    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">\n\n");
        foreach (string row in rows)
        {
            text.Append(row).Append('\n');
        }

        text.Append("\n</ResourceDictionary>\n");

        // Written only when it CHANGED, or every build dirties a tracked file
        // and every incremental build recompiles the XAML that depends on it.
        string emitted = text.ToString();
        if (!File.Exists(Output) || File.ReadAllText(Output) != emitted)
        {
            File.WriteAllText(Output, emitted);
            Log.LogMessage(MessageImportance.High, "Icons: wrote {0} glyphs to {1}", rows.Count, Output);
        }

        // A code fragment succeeds whatever it logged. Without this a refused
        // file is an error line in a build that goes on without the icon.
        Success = !Log.HasLoggedErrors;
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Outside the target: Inputs is evaluated before the target runs, so an
    ItemGroup inside it would never trigger a re-run.
  -->
  <ItemGroup>
    <SpectraIcon Include="$(MSBuildThisFileDirectory)Assets\Icons\*.svg" />
    <!-- Entities and lights. SpectraEngine.Editing owns them: its 3D view draws the same files. -->
    <SpectraIcon Include="$(MSBuildThisFileDirectory)..\SpectraEngine.Editing\Assets\Icons\*.svg" />
  </ItemGroup>

  <Target Name="GenerateIcons" BeforeTargets="BeforeBuild"
          Inputs="@(SpectraIcon);$(MSBuildThisFileFullPath)"
          Outputs="$(MSBuildThisFileDirectory)Theme\Icons.axaml">
    <GenerateIconResources Icons="@(SpectraIcon)" Output="$(MSBuildThisFileDirectory)Theme\Icons.axaml" />
  </Target>

</Project>
