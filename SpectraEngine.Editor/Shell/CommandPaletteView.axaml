<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.CommandPaletteView">

  <!-- Its own control so the render suite can construct and measure it. -->
  <Border Classes="palette">
    <DockPanel>
      <TextBox x:Name="Query" DockPanel.Dock="Top" Classes="field"
               PlaceholderText="Type a command" />
      <!-- Count of matches the capped list is not showing. -->
      <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Classes="palettefoot"
                 IsVisible="False" />
      <ListBox x:Name="Rows" Classes="palettelist" MaxHeight="320">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="shell:ShellCommand">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="palettechord" Text="{Binding Gesture}"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
