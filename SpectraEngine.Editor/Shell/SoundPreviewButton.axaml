<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpectraEngine.Editor.Shell.SoundPreviewButton"
             Width="18" Height="18">

  <!-- Play, or stop while this file is the one playing. As big as the control
       is made, so it fits a list row and a field row alike. -->

  <UserControl.Styles>
    <Style Selector="Button.soundpreview">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.soundpreview /template/ ContentPresenter#PART_ContentPresenter">
      <!-- #00FFFFFF, not Transparent (transparent black): a fade to a
           translucent white would pass through grey. -->
      <Setter Property="Background" Value="#00FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.soundpreview:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    </Style>
    <Style Selector="Button.soundpreview:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
    </Style>

    <!-- Filled, like the Play key's glyphs. Stop is amber there too. -->
    <Style Selector="Button.soundpreview Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraTextBody}" />
    </Style>
    <Style Selector="Button.soundpreview:pointerover Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.soundpreview Path.stopglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraMode}" />
    </Style>

    <!-- A picker's selected row is filled with the accent, and its text
         changes colour to stay readable. So does the glyph. -->
    <Style Selector="ListBoxItem:selected Button.soundpreview Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraTextOnAccent}" />
    </Style>
  </UserControl.Styles>

  <Button x:Name="ButtonPart" Classes="soundpreview" Focusable="False" Click="OnPressed">
    <Panel Width="16" Height="16">
      <Path x:Name="PlayGlyph" Classes="icon playglyph" StrokeThickness="0"
            Data="{StaticResource IconPlay}" />
      <Path x:Name="StopGlyph" Classes="icon stopglyph" StrokeThickness="0"
            Data="{StaticResource IconStop}" IsVisible="False" />
    </Panel>
  </Button>
</UserControl>
