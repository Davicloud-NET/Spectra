<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.ConsolePanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <!-- A command line over the editor's verbs. Shares the output log, so a
       command and the error it caused sit together in order. -->

  <Grid RowDefinitions="*,Auto">
    <Grid.Styles>
      <Style Selector="TextBlock.line">
        <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
        <Setter Property="Margin" Value="0,1" />
      </Style>
    </Grid.Styles>

    <ScrollViewer Grid.Row="0" Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <!-- Keep geometry and font identical to the Output tab: same log, same rows. -->
      <ItemsControl ItemsSource="{Binding Output.Entries}" Margin="0,6,0,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:OutputEntry">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="value" VerticalAlignment="Top"
                         Margin="0,2,0,0"
                         Foreground="{StaticResource SpectraTextDisabled}"
                         Text="{Binding TimeLabel}" />
              <TextBlock Grid.Column="1" Classes="line" Text="{Binding Text}"
                         Foreground="{Binding SeverityBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Grid.Column="2" Classes="value" VerticalAlignment="Top"
                         Margin="0,2,0,0"
                         Foreground="{StaticResource SpectraTextDisabled}"
                         Text="{Binding CountLabel}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,4,8,8" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Classes="value" VerticalAlignment="Center"
                 Foreground="{StaticResource SpectraMode}" Text="&gt;" />
      <TextBox Grid.Column="1" Name="Input" Classes="field num"
               TextAlignment="Left"
               PlaceholderText="Type help"
               KeyDown="OnInputKeyDown" />
    </Grid>
  </Grid>
</UserControl>
