<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.MapsPanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <!-- The project's maps in manifest order, then any on disk the manifest
       does not name. -->

  <UserControl.Resources>
    <!-- Shared by every row; DataContext comes from the row that opened it. -->
    <ContextMenu x:Key="MapMenu" x:DataType="shell:ProjectMapRow">
      <MenuItem Header="Open" Click="OnMenuOpen" />
      <MenuItem Header="Set as startup map" Click="OnMenuSetStartup"
                IsVisible="{Binding !IsStartup}" />
      <Separator />
      <MenuItem Header="Show in Explorer" Click="OnMenuReveal" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.maprow">
      <Setter Property="Height" Value="{StaticResource SpectraTreeRowHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>
    <Style Selector="Button.maprow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.maprow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="Button.maprow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
    </Style>
    <Style Selector="Button.maprow TextBlock.mapname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
    </Style>
    <Style Selector="Button.maprow:pointerover TextBlock.mapname">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- The dock reserves this pane's space even with no project open. -->
    <TextBlock DockPanel.Dock="Top" Margin="12,10" TextWrapping="Wrap"
               Text="No project open. Maps saved into a project's Maps folder are listed here."
               FontSize="{StaticResource SpectraFontSecondary}"
               Foreground="{StaticResource SpectraTextMuted}"
               IsVisible="{Binding !HasProject}" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top" IsVisible="{Binding HasProject}">
      <ItemsControl ItemsSource="{Binding ProjectMaps}" Margin="4,4,4,6">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:ProjectMapRow">
            <Button Classes="maprow" Click="OnMapClicked"
                    ContextMenu="{StaticResource MapMenu}"
                    ToolTip.Tip="{Binding RelativePath}">
              <Grid ColumnDefinitions="10,*,Auto" Margin="4,0,8,0">
                <!-- Startup map dot. 6x6 radius 3, same circle as the dirty dot. -->
                <Border Grid.Column="0" Width="6" Height="6"
                        CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="1,0,0,0"
                        Background="{StaticResource SpectraAccent}"
                        IsVisible="{Binding IsStartup}" />
                <TextBlock Grid.Column="1" Classes="mapname" Text="{Binding Name}"
                           FontSize="{StaticResource SpectraFontBase}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="unlisted"
                           FontFamily="{StaticResource SpectraFontMono}"
                           FontSize="{StaticResource SpectraFontMicro}"
                           Foreground="{StaticResource SpectraTextMuted}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsUnlisted}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
