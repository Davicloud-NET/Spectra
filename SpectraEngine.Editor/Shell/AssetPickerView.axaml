<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.AssetPickerView">

  <!-- A searchable list, not a ComboBox: the options are however many files
       the project has. Keyboard matches the command palette. -->
  <Border Classes="palette" Width="280">
    <DockPanel>
      <TextBox x:Name="Query" DockPanel.Dock="Top" Classes="field"
               PlaceholderText="Search materials" />

      <!-- Says why the list is empty. -->
      <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Classes="palettefoot"
                 IsVisible="False" TextWrapping="Wrap" />

      <ListBox x:Name="Rows" Classes="palettelist" MaxHeight="300">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="shell:AssetPickerRow">
            <!-- Sounds only: a play button before the name. The "None" row
                 keeps the column empty, so the names line up. -->
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Panel Grid.Column="0" Width="24" IsVisible="{Binding IsSound}">
                <shell:SoundPreviewButton HorizontalAlignment="Left"
                                          IsVisible="{Binding CanPreview}"
                                          ContentPath="{Binding ContentPath}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding Stem}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="palettechord" Text="{Binding Folder}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         MaxWidth="120" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
