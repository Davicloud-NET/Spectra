<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.PropertiesPanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <!--
    The inspector. A vector row is two lines: at 308px three cells beside a
    label column are too narrow for a real number. Axis letters and row labels
    are drag handles.
  -->

  <UserControl.Styles>
    <!-- Row label. Also the drag handle when the value is a number. -->
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.rowlabel.scrub">
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="TextBlock.rowlabel.scrub:pointerover">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>

    <!-- Unit, on the label line so it costs the cells no width. -->
    <Style Selector="TextBlock.rowunit">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Axis letter, in the colour its arrow has in the viewport. -->
    <Style Selector="TextBlock.axis">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Width" Value="14" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="TextBlock.axis.x"><Setter Property="Foreground" Value="{StaticResource SpectraAxisX}" /></Style>
    <Style Selector="TextBlock.axis.y"><Setter Property="Foreground" Value="{StaticResource SpectraAxisY}" /></Style>
    <Style Selector="TextBlock.axis.z"><Setter Property="Foreground" Value="{StaticResource SpectraAxisZ}" /></Style>

    <!-- One cell: axis letter plus field. -->
    <Style Selector="TextBlock.rejection">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDanger}" />
      <Setter Property="Margin" Value="0,1,0,3" />
    </Style>

    <!-- Asset value: a button, so raised rather than sunken like a field. -->
    <Style Selector="Button.assetcell">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.assetcell:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    </Style>
    <Style Selector="Button.assetcell TextBlock.assetname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A note is a warning: amber, never the accent. -->
    <Style Selector="Border.notebadge">
      <Setter Property="Background" Value="{StaticResource SpectraModeWash}" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.notebadge TextBlock">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
    </Style>

    <!-- A value cell is a well: darker than the panel, with a light edge. -->
    <Style Selector="Border.cell">
      <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderInput}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
    </Style>
    <!-- Refused cell: danger colour on the border only, same thickness, so
         nothing shifts. -->
    <Style Selector="Border.cell.invalid">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderDanger}" />
    </Style>
    <Style Selector="Border.cell.invalid:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderDanger}" />
    </Style>

    <Style Selector="Border.cell:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderInputHover}" />
    </Style>

    <!-- The field inside a cell draws no border of its own. -->
    <Style Selector="TextBox.cellfield">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="2,0,4,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{StaticResource SpectraAccentRest}" />
      <Setter Property="CaretBrush" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="TextBox.cellfield /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.cellfield /template/ TextBlock#PART_Watermark">
      <Setter Property="FontFamily" Value="{StaticResource SpectraFontMono}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!-- The name: an editable title, no box around it. -->
    <Style Selector="TextBox.nametitle">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Margin" Value="-5,0,0,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{StaticResource SpectraAccentRest}" />
      <Setter Property="CaretBrush" Value="{StaticResource SpectraAccent}" />
    </Style>
    <Style Selector="TextBox.nametitle /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.nametitle:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
    </Style>
    <Style Selector="TextBox.nametitle:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource SpectraBgInput}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraAccent}" />
    </Style>

    <!-- Kind chip: Block, Part, Cut, Light, Mesh. -->
    <!-- A label, not a button, so no outline. -->
    <Style Selector="Border.kindchip">
      <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Standing warning about the selection, in its own slot under the header. -->
    <Style Selector="Border.classwarn">
      <Setter Property="Background" Value="{StaticResource SpectraModeWash}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraWarning}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="12,8,12,0" />
    </Style>

    <!-- A section starts with a band, and every row under it ends in a rule,
         so each property reads as its own strip. -->
    <Style Selector="Border.sectionband">
      <Setter Property="Background" Value="{StaticResource SpectraBgRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.sectionband TextBlock.sectionhead">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Border.proprow">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,4,12,4" />
    </Style>

    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="{StaticResource SpectraFieldHeight}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>

    <!-- Sends: one wire is a block of labelled fields read downwards.
         Six columns do not fit in 308px. -->
    <Style Selector="Border.wire">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,5,0,7" />
    </Style>

    <Style Selector="TextBlock.wirelabel">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Amber, not danger: a wire with a missing target is kept as authored.
         The target may be spawned at run time. -->
    <Style Selector="TextBlock.wirewarn">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraWarning}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- The popups come first: a DockPanel only stretches its last child,
         and that has to be the scroll area. -->
    <!-- The entity picker. -->
    <Popup x:Name="TargetPopup" Placement="BottomEdgeAlignedLeft"
           IsLightDismissEnabled="True">
      <shell:EntityPickerView x:Name="TargetPicker" />
    </Popup>

    <!-- The asset picker. -->
    <Popup x:Name="AssetPopup" Placement="BottomEdgeAlignedLeft"
           IsLightDismissEnabled="True" Closed="OnAssetPopupClosed">
      <shell:AssetPickerView x:Name="AssetPicker" />
    </Popup>

    <Popup x:Name="ColorPopup" Placement="BottomEdgeAlignedLeft"
           IsLightDismissEnabled="True" Closed="OnColorPopupClosed">
      <shell:ColorPickerView x:Name="ColorPicker" />
    </Popup>

    <!-- Header: name and kind. -->
    <Border DockPanel.Dock="Top"
            BorderBrush="{StaticResource SpectraBorderSoft}"
            BorderThickness="0,0,0,1"
            Padding="12,8,12,8"
            IsVisible="{Binding Properties.HasSelection}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" x:Name="NameBox" Classes="nametitle"
                 IsVisible="{Binding !Properties.IsMultiple}"
                 Text="{Binding Properties.NameField.Text, Mode=TwoWay}"
                 GotFocus="OnPropertyFieldFocused"
                 LostFocus="OnPropertyFieldBlurred"
                 KeyDown="OnPropertyFieldKeyDown"
                 ToolTip.Tip="Rename. Enter or click away to keep it, Escape to abandon it." />
        <TextBlock Grid.Column="0" Text="{Binding Properties.MultipleLabel}"
                   IsVisible="{Binding Properties.IsMultiple}"
                   FontSize="{StaticResource SpectraFontBase}"
                   Foreground="{StaticResource SpectraTextEmphasis}"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1" Classes="kindchip"
                IsVisible="{Binding Properties.HasKind}">
          <TextBlock Text="{Binding Properties.HeaderKind}"
                     FontSize="{StaticResource SpectraFontMicro}"
                     Foreground="{StaticResource SpectraTextBody}" />
        </Border>
      </Grid>
    </Border>

    <!-- Unknown entity class: the rows below are still editable, only the
         schema is missing. -->
    <Border DockPanel.Dock="Top" Classes="classwarn"
            IsVisible="{Binding Properties.HasUnknownClass}">
      <TextBlock Text="{Binding Properties.UnknownClassLabel}"
                 TextWrapping="Wrap"
                 FontSize="{StaticResource SpectraFontSecondary}"
                 Foreground="{StaticResource SpectraTextBody}" />
    </Border>

    <!-- Empty state. -->
    <StackPanel DockPanel.Dock="Top" Margin="12,14,12,0" Spacing="10"
                IsVisible="{Binding !Properties.HasSelection}">
      <TextBlock Classes="prose" TextWrapping="Wrap"
                 Foreground="{StaticResource SpectraTextMuted}"
                 Text="Select something in the viewport or the scene tree to edit it." />

      <TextBlock Classes="prose" TextWrapping="Wrap"
                 Foreground="{StaticResource SpectraTextMuted}"
                 Text="Tip: drag the x, y or z beside a number to change it." />
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding Properties.HasSelection}">
      <!-- Everything below the header scrolls together. -->
      <StackPanel>

      <!-- Now: what the entity is doing, while the level runs. -->
      <StackPanel IsVisible="{Binding Properties.LiveState.HasRows}">
        <Border Classes="sectionband">
          <TextBlock Classes="sectionhead" Text="Now" />
        </Border>
        <ItemsControl ItemsSource="{Binding Properties.LiveState.Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:EntityStateRowModel">
              <Border Classes="proprow">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="rowlabel" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}"
                             FontFamily="{StaticResource SpectraFontMono}"
                             FontSize="{StaticResource SpectraFontSmall}"
                             Foreground="{StaticResource SpectraTextEmphasis}"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Properties.Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:PropertyGroupModel">
            <StackPanel>

              <Border Classes="sectionband" IsVisible="{Binding HasName}">
                <TextBlock Classes="sectionhead" Text="{Binding Name}" />
              </Border>

              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="shell:PropertyRowModel">
                    <Border Classes="proprow">
                    <StackPanel>

                      <!-- Why the last commit was refused. -->
                      <TextBlock Classes="rejection" Text="{Binding Rejection}"
                                 IsVisible="{Binding HasRejection}"
                                 TextWrapping="Wrap" />

                      <!-- Vector: label line, then three cells -->
                      <StackPanel IsVisible="{Binding IsVector}" Margin="0,2,0,4">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,3">
                          <TextBlock Grid.Column="0" Classes="rowlabel scrub" Text="{Binding Name}"
                                     PointerPressed="OnLabelPressed"
                                     PointerMoved="OnScrubMoved"
                                     PointerReleased="OnScrubReleased"
                                     PointerCaptureLost="OnScrubLost"
                                     ToolTip.Tip="Drag sideways to change all three. Shift for ten times, Ctrl for a tenth." />
                          <TextBlock Grid.Column="1" Text="{Binding PartialLabel}" Margin="6,0"
                                     FontSize="{StaticResource SpectraFontMicro}"
                                     Foreground="{StaticResource SpectraTextMuted}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsPartial}" />
                          <TextBlock Grid.Column="2" Classes="rowunit" Text="{Binding Unit}"
                                     IsVisible="{Binding HasUnit}" />
                        </Grid>

                        <!-- -4 right margin cancels the last cell's trailing gap. -->
                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,-4,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="shell:PropertyFieldModel">
                              <Border Classes="cell" Classes.invalid="{Binding HasRejection}" Margin="0,0,4,0">
                                <Grid ColumnDefinitions="Auto,*">
                                  <TextBlock Grid.Column="0" Classes="axis"
                                             Classes.x="{Binding IsX}"
                                             Classes.y="{Binding IsY}"
                                             Classes.z="{Binding IsZ}"
                                             Text="{Binding Label}"
                                             PointerPressed="OnAxisPressed"
                                             PointerMoved="OnScrubMoved"
                                             PointerReleased="OnScrubReleased"
                                             PointerCaptureLost="OnScrubLost"
                                             ToolTip.Tip="Drag sideways to change this one." />
                                  <TextBox Grid.Column="1" Classes="cellfield"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           PlaceholderText="{Binding Placeholder}"
                                           GotFocus="OnPropertyFieldFocused"
                                           LostFocus="OnPropertyFieldBlurred"
                                           KeyDown="OnPropertyFieldKeyDown" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- Everything else: label left, editor right -->
                      <Grid ColumnDefinitions="86,*" Margin="0,1" IsVisible="{Binding !IsVector}">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Classes="rowlabel" Classes.scrub="{Binding IsScrubbable}"
                                     Text="{Binding Name}"
                                     PointerPressed="OnLabelPressed"
                                     PointerMoved="OnScrubMoved"
                                     PointerReleased="OnScrubReleased"
                                     PointerCaptureLost="OnScrubLost" />
                          <TextBlock Text="{Binding PartialLabel}" Margin="5,0,0,0"
                                     FontSize="{StaticResource SpectraFontMicro}"
                                     Foreground="{StaticResource SpectraTextMuted}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsPartial}" />
                        </StackPanel>

                        <!-- Scalar -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}"
                                      IsVisible="{Binding IsScalar}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="shell:PropertyFieldModel">
                              <Border Classes="cell" Classes.invalid="{Binding HasRejection}">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBox Grid.Column="0" Classes="cellfield"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           PlaceholderText="{Binding Placeholder}"
                                           GotFocus="OnPropertyFieldFocused"
                                           LostFocus="OnPropertyFieldBlurred"
                                           KeyDown="OnPropertyFieldKeyDown" />
                                  <TextBlock Grid.Column="1" Classes="rowunit" Margin="0,0,6,0"
                                             Text="{Binding Unit}" IsVisible="{Binding HasUnit}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Colour: swatch plus hex. The hex box commits on Enter
                             or blur, never per keystroke: "#8" does not parse. -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*"
                              IsVisible="{Binding IsColor}">
                          <Border Grid.Column="0" Classes="swatch" Cursor="Hand"
                                  PointerPressed="OnSwatchPressed"
                                  Background="{Binding Swatch}" Margin="0,0,5,0"
                                  ToolTip.Tip="{Binding Hex}" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="shell:PropertyFieldModel">
                                <Border Classes="cell" Classes.invalid="{Binding HasRejection}">
                                  <TextBox Classes="cellfield" TextAlignment="Left" Padding="6,0"
                                           Text="{Binding Text, Mode=TwoWay}"
                                           PlaceholderText="mixed"
                                           GotFocus="OnPropertyFieldFocused"
                                           LostFocus="OnPropertyFieldBlurred"
                                           KeyDown="OnPropertyFieldKeyDown"
                                           ToolTip.Tip="Written in sRGB, stored as linear light." />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>

                        <CheckBox Grid.Column="1" IsChecked="{Binding Flag, Mode=TwoWay}"
                                  IsVisible="{Binding IsBoolean}"
                                  VerticalAlignment="Center" />

                        <!-- Shows the display words. The commit writes the tokens. -->
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ChoiceLabels}"
                                  SelectedItem="{Binding ChoiceLabel, Mode=TwoWay}"
                                  IsVisible="{Binding IsChoice}"
                                  ToolTip.Tip="{Binding Help}"
                                  HorizontalAlignment="Stretch" />

                        <!-- Target: a text box plus picker. Wildcards and runtime
                             tokens are legal and no list can offer them. -->
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                              IsVisible="{Binding IsTarget}">
                          <Border Grid.Column="0" Classes="cell"
                                  Classes.invalid="{Binding HasRejection}">
                            <TextBox DataContext="{Binding Fields[0]}"
                                     Classes="cellfield" TextAlignment="Left" Padding="6,0"
                                     Text="{Binding Text, Mode=TwoWay}"
                                     PlaceholderText="entity name"
                                     GotFocus="OnPropertyFieldFocused"
                                     LostFocus="OnPropertyFieldBlurred"
                                     KeyDown="OnPropertyFieldKeyDown" />
                          </Border>
                          <Button Grid.Column="1" Classes="seg" Content="..." Margin="4,0,0,0"
                                  IsEnabled="{Binding CanPickTarget}"
                                  Click="OnPickRowTargetPressed"
                                  ToolTip.Tip="Pick an entity in this scene." />
                        </Grid>

                        <!-- Asset: file stem, full path in the tooltip. The whole
                             cell opens the picker. -->
                        <Button Grid.Column="1" Classes="assetcell"
                                IsVisible="{Binding IsAsset}"
                                Click="OnAssetCellPressed"
                                ToolTip.Tip="{Binding AssetPath}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="assetname"
                                       Text="{Binding AssetLabel}" />
                            <Border Grid.Column="1" Classes="notebadge"
                                    IsVisible="{Binding HasNote}">
                              <TextBlock Text="{Binding Note}" />
                            </Border>
                          </Grid>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding ReadOnlyText}"
                                   IsVisible="{Binding IsReadOnly}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource SpectraFontMono}"
                                   FontSize="{StaticResource SpectraFontSmall}"
                                   Foreground="{StaticResource SpectraTextMuted}"
                                   ToolTip.Tip="{Binding ReadOnlyText}" />
                      </Grid>
                    </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Sends: the wires leaving this entity. Single-entity selection only. -->
      <StackPanel Margin="12,12,12,14" Spacing="4"
                  IsVisible="{Binding Properties.Wiring.HasEntity}">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="sectionhead" Text="Sends" />
          <Button Grid.Column="1" Classes="seg" Content="Add"
                  Click="OnAddConnection"
                  ToolTip.Tip="Wire one of this entity's outputs to another entity's input." />
        </Grid>

        <!-- No schema: the output dropdowns below become text boxes. -->
        <TextBlock Classes="wirewarn" TextWrapping="Wrap"
                   IsVisible="{Binding Properties.Wiring.ShowsUnknownOutputs}"
                   Text="No schema for this class, so its outputs are typed rather than picked." />

        <TextBlock Classes="prose" Foreground="{StaticResource SpectraTextMuted}"
                   IsVisible="{Binding Properties.Wiring.IsEmpty}"
                   Text="Nothing wired yet." />

        <!-- What the picker left out. -->
        <TextBlock Classes="micro" TextWrapping="Wrap"
                   Text="{Binding Properties.Wiring.TargetsNote}"
                   IsVisible="{Binding Properties.Wiring.TargetsTruncated}" />

        <ItemsControl ItemsSource="{Binding Properties.Wiring.Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:ConnectionRowModel">
              <Border Classes="wire">
                <StackPanel Spacing="3">

                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding OutputChoices}"
                              SelectedItem="{Binding Output, Mode=TwoWay}"
                              IsVisible="{Binding HasOutputChoices}"
                              HorizontalAlignment="Stretch" />
                    <!-- Typed output, for a class with no schema. A field model:
                         a two-way Text binding would post an edit per keystroke. -->
                    <Border Grid.Column="0" Classes="cell"
                            IsVisible="{Binding !HasOutputChoices}">
                      <!-- DataContext is set on the TextBox, not the Border: the
                           Border's IsVisible binding must resolve against the row. -->
                      <TextBox DataContext="{Binding OutputField}"
                               Classes="cellfield" TextAlignment="Left" Padding="6,0"
                               Text="{Binding Text, Mode=TwoWay}"
                               PlaceholderText="output"
                               GotFocus="OnPropertyFieldFocused"
                               LostFocus="OnPropertyFieldBlurred"
                               KeyDown="OnPropertyFieldKeyDown" />
                    </Border>
                    <Button Grid.Column="1" Classes="seg" Content="Remove" Margin="4,0,0,0"
                            Click="OnRemoveConnection"
                            ToolTip.Tip="Delete this wire." />
                  </Grid>

                  <!-- Each cell's DataContext is its own PropertyFieldModel, so
                       the panel's focus, blur and key handlers apply unchanged.
                       The target is a text box, not a dropdown, for the same
                       reason as a Target property row. -->
                  <Grid ColumnDefinitions="52,*,Auto">
                    <TextBlock Grid.Column="0" Classes="wirelabel" Text="Target" />
                    <Border Grid.Column="1" Classes="cell" DataContext="{Binding TargetField}">
                      <TextBox x:DataType="shell:PropertyFieldModel"
                               Classes="cellfield" TextAlignment="Left" Padding="6,0"
                               Text="{Binding Text, Mode=TwoWay}"
                               PlaceholderText="entity to send to"
                               GotFocus="OnPropertyFieldFocused"
                               LostFocus="OnPropertyFieldBlurred"
                               KeyDown="OnPropertyFieldKeyDown" />
                    </Border>
                    <Button Grid.Column="2" Classes="seg" Content="..." Margin="4,0,0,0"
                            Click="OnPickTargetPressed"
                            ToolTip.Tip="Pick an entity in this scene." />
                  </Grid>

                  <Grid ColumnDefinitions="52,*">
                    <TextBlock Grid.Column="0" Classes="wirelabel" Text="Input" />
                    <!-- Dropdown only when the target resolves to one entity of
                         a known class. Otherwise a text box. -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding InputChoices}"
                              SelectedItem="{Binding Input, Mode=TwoWay}"
                              IsVisible="{Binding HasInputChoices}"
                              HorizontalAlignment="Stretch" />
                    <Border Grid.Column="1" Classes="cell"
                            IsVisible="{Binding !HasInputChoices}">
                      <TextBox DataContext="{Binding InputField}"
                               Classes="cellfield" TextAlignment="Left" Padding="6,0"
                               Text="{Binding Text, Mode=TwoWay}"
                               PlaceholderText="input to send"
                               GotFocus="OnPropertyFieldFocused"
                               LostFocus="OnPropertyFieldBlurred"
                               KeyDown="OnPropertyFieldKeyDown" />
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="52,*">
                    <TextBlock Grid.Column="0" Classes="wirelabel" Text="Param" />
                    <Border Grid.Column="1" Classes="cell" DataContext="{Binding ParameterField}">
                      <TextBox x:DataType="shell:PropertyFieldModel"
                               Classes="cellfield" TextAlignment="Left" Padding="6,0"
                               Text="{Binding Text, Mode=TwoWay}"
                               PlaceholderText="none"
                               GotFocus="OnPropertyFieldFocused"
                               LostFocus="OnPropertyFieldBlurred"
                               KeyDown="OnPropertyFieldKeyDown" />
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="52,*,44,*">
                    <TextBlock Grid.Column="0" Classes="wirelabel" Text="Delay" />
                    <Border Grid.Column="1" Classes="cell" Margin="0,0,6,0"
                            DataContext="{Binding DelayField}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:DataType="shell:PropertyFieldModel"
                                 Grid.Column="0" Classes="cellfield"
                                 Text="{Binding Text, Mode=TwoWay}"
                                 GotFocus="OnPropertyFieldFocused"
                                 LostFocus="OnPropertyFieldBlurred"
                                 KeyDown="OnPropertyFieldKeyDown" />
                        <TextBlock Grid.Column="1" Classes="rowunit" Margin="0,0,6,0" Text="s" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Classes="wirelabel" Text="Times" />
                    <Border Grid.Column="3" Classes="cell" DataContext="{Binding TimesField}">
                      <TextBox x:DataType="shell:PropertyFieldModel"
                               Classes="cellfield"
                               Text="{Binding Text, Mode=TwoWay}"
                               GotFocus="OnPropertyFieldFocused"
                               LostFocus="OnPropertyFieldBlurred"
                               KeyDown="OnPropertyFieldKeyDown"
                               ToolTip.Tip="How many times this wire may fire. -1 fires forever." />
                    </Border>
                  </Grid>

                  <TextBlock Classes="wirewarn" TextWrapping="Wrap"
                             IsVisible="{Binding HasTargetWarning}"
                             Text="{Binding TargetWarning}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Receives: the wires that arrive here. Read only: a wire is edited
           on the entity that sends it. -->
      <StackPanel Margin="12,0,12,14" Spacing="4"
                  IsVisible="{Binding Properties.Arrivals.HasEntity}">

        <TextBlock Classes="sectionhead" Text="Receives" />

        <TextBlock Classes="prose" Foreground="{StaticResource SpectraTextMuted}"
                   IsVisible="{Binding Properties.Arrivals.IsEmpty}"
                   Text="Nothing is wired to this." />

        <ItemsControl ItemsSource="{Binding Properties.Arrivals.Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:EntityArrivalRow">
              <Border Classes="wire">
                <WrapPanel Orientation="Horizontal">
                  <!-- A key, so the name reads as something to press. -->
                  <Button Classes="chip" Height="22" MaxWidth="150" Margin="0,0,8,0"
                          Click="OnArrivalSenderClicked"
                          ToolTip.Tip="Select the entity that sends this.">
                    <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SpectraTextEmphasis}" />
                  </Button>
                  <TextBlock Text="{Binding Output}" VerticalAlignment="Center" />
                  <TextBlock Text="&#8594;" Margin="6,0" VerticalAlignment="Center"
                             Foreground="{StaticResource SpectraTextMuted}" />
                  <TextBlock Text="{Binding Input}" VerticalAlignment="Center" />
                </WrapPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="micro" TextWrapping="Wrap"
                   IsVisible="{Binding Properties.Arrivals.HasRows}"
                   Text="A wire that arrives here is edited on the entity that sends it. Click a name to go there." />

        <TextBlock Classes="micro" TextWrapping="Wrap"
                   Text="{Binding Properties.Arrivals.TruncatedNote}"
                   IsVisible="{Binding Properties.Arrivals.IsTruncated}" />
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
