<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.ContentPanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <!--
    The project's Assets folder, which nothing in this editor could show before.

    A GRID of tiles here and a LIST everywhere else, and that is not an
    inconsistency. The shell's rule is that a list of NAMES must be a list,
    because a bordered tile per row costs three times the height and carries no
    more information. A texture is not a name: the picture IS the information,
    and a tile is the smallest thing that can carry it. The rule was about
    decorated rows, not about tiles that show something.
  -->

  <UserControl.Resources>
    <!-- Shared by every tile: one menu instance, the shape the scene tree's
         row menu already uses. Revealing on disk moved HERE from the
         double-click, which now does the ordinary thing instead. -->
    <ContextMenu x:Key="ContentMenu" x:DataType="shell:ContentEntry">
      <MenuItem Header="Insert into scene" Click="OnMenuInsert"
                IsVisible="{Binding !IsFolder}" />
      <MenuItem Header="Show in Explorer" Click="OnMenuReveal" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- Search first, because a project with a few hundred assets is faster to
         type at than to walk. A query replaces the folder view rather than
         filtering it: "where are the bricks" is not "which file in THIS folder
         is called brick", and a filter would report nothing for a file one
         level up. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,6,8,4" ColumnSpacing="6">
      <Button Grid.Column="0" Classes="ghost" Name="UpButton" Click="OnUpClicked"
              IsEnabled="{Binding Content.CanGoUp}" ToolTip.Tip="Up one folder">
        <Path Classes="icon" Data="{StaticResource IconArrowUp}" />
      </Button>

      <TextBox Grid.Column="1" Classes="field" Name="SearchBox"
               PlaceholderText="Search the project"
               Text="{Binding Content.Query, Mode=TwoWay}"
               KeyDown="OnSearchKeyDown" />

      <Button Grid.Column="2" Classes="ghost" Click="OnViewModeClicked"
              ToolTip.Tip="Switch between tiles and rows">
        <Path Classes="icon" Data="{StaticResource IconList}" />
      </Button>

      <Button Grid.Column="3" Classes="ghost" Click="OnRefreshClicked"
              ToolTip.Tip="Walk the project again">
        <Path Classes="icon" Data="{StaticResource IconRefresh}" />
      </Button>
    </Grid>

    <!-- The kind filters, and where you are. Chips rather than a dropdown: four
         values, all worth one click, and the lit one says the answer without
         being opened. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="8,0,8,6" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
        <Button Classes="chip" Classes.active="{Binding Content.IsFilterAll}"
                Content="All" Tag="All" Click="OnFilterClicked" />
        <Button Classes="chip" Classes.active="{Binding Content.IsFilterTextures}"
                Content="Textures" Tag="Textures" Click="OnFilterClicked" />
        <Button Classes="chip" Classes.active="{Binding Content.IsFilterMaterials}"
                Content="Materials" Tag="Materials" Click="OnFilterClicked" />
        <Button Classes="chip" Classes.active="{Binding Content.IsFilterModels}"
                Content="Models" Tag="Models" Click="OnFilterClicked" />
      </StackPanel>

      <!-- Every segment is a button, because the path is also the way back up:
           a breadcrumb you cannot click is a label. Hidden while searching,
           where the list is not a folder and the path would be a lie. -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Content.Breadcrumbs}"
                    IsVisible="{Binding !Content.IsSearching}"
                    HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:BreadcrumbSegment">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="/" Classes="micro" VerticalAlignment="Center" Margin="1,0" />
              <Button Classes="ghost crumb" Content="{Binding Label}"
                      Tag="{Binding FullPath}" Click="OnCrumbClicked" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <TextBlock Grid.Row="2" Classes="prose" Margin="12,4,12,0"
               Foreground="{StaticResource SpectraTextMuted}"
               IsVisible="{Binding !Content.HasContent}"
               Text="{Binding Content.EmptyMessage}" />

    <!-- The list, which VIRTUALISES: a ListBox over a VirtualizingStackPanel
         realises the rows on screen and no others, which is why it is the mode
         with no cap. Stock Avalonia has no virtualising wrap panel, so the grid
         below is capped instead. -->
    <ListBox Grid.Row="2" Name="ListRows" Classes="contentlist"
             ItemsSource="{Binding Content.Entries}"
             SelectionChanged="OnListSelectionChanged"
             DoubleTapped="OnEntryActivated">
      <ListBox.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Content.HasContent" />
          <Binding Path="Content.IsListView" />
        </MultiBinding>
      </ListBox.IsVisible>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="shell:ContentEntry">
          <Grid ColumnDefinitions="20,*,Auto,Auto" ColumnSpacing="8"
                ContextMenu="{StaticResource ContentMenu}">
            <Panel Grid.Column="0" Width="20" Height="16">
              <Path Classes="icon" IsVisible="{Binding !HasThumbnail}"
                    Stroke="{Binding KindBrush}" Data="{Binding Icon}" />
              <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                     Stretch="Uniform" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource SpectraFontSmall}" />
            <TextBlock Grid.Column="2" Text="{Binding FolderLabel}" Classes="micro"
                       VerticalAlignment="Center" MaxWidth="140"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Classes="micro"
                       VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Content.HasContent" />
          <Binding Path="Content.IsGridView" />
        </MultiBinding>
      </ScrollViewer.IsVisible>
      <ItemsControl ItemsSource="{Binding Content.Entries}" Margin="6,0,6,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:ContentEntry">
            <Border Classes="tile" Classes.selected="{Binding IsSelected}"
                    DoubleTapped="OnEntryActivated"
                    ContextMenu="{StaticResource ContentMenu}"
                    ToolTip.Tip="{Binding Name}">
              <StackPanel Width="88" Margin="0,6">

                <!-- The picture when there is one, the kind glyph when there is
                     not. Both at the same footprint, so a folder of half-decoded
                     images does not reflow as they land. -->
                <Panel Height="58" Margin="0,0,0,4">
                  <!-- Uniform + no transform, deliberately breaking the icon
                       class's shared-grid rule for this one DECORATIVE use:
                       with Stretch=None the 16-grid ink drew at its authored
                       coordinates inside the 22px element, visibly off-centre
                       toward the top-left of every tile. The shared grid is
                       about 16px icons in rows; a tile centrepiece is not one. -->
                  <Path Classes="icon" Width="22" Height="22"
                        Stretch="Uniform" RenderTransform="none"
                        IsVisible="{Binding !HasThumbnail}"
                        Stroke="{Binding KindBrush}"
                        Data="{Binding Icon}" />
                  <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}"
                         Stretch="Uniform" Margin="4" />
                </Panel>

                <TextBlock Text="{Binding Name}" FontSize="{StaticResource SpectraFontSmall}"
                           Foreground="{StaticResource SpectraTextBody}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="80" />
                <TextBlock Text="{Binding SizeLabel}" Classes="micro"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <!-- Where it is, on a search result only: two projects in three
                     have a brick, and a flat result list has nothing else to
                     tell them apart. -->
                <TextBlock Text="{Binding FolderLabel}" Classes="micro"
                           IsVisible="{Binding FolderLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           MaxWidth="80" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- What was left out, or what the index is doing. A capped list with no
         count looks exactly like a complete one, and a blank pane during a walk
         looks like a project with nothing in it. -->
    <TextBlock Grid.Row="3" Classes="micro" Margin="10,2"
               Text="{Binding Content.ResultNote}"
               IsVisible="{Binding Content.ResultNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" />

    <!-- What the selection IS, in the engine's own name for it. A tile shows a
         picture and a file name; this says the content-relative path, which is
         what a material writes down and what a map records. -->
    <Border Grid.Row="4" Classes="detailstrip" IsVisible="{Binding Content.HasSelected}">
      <StackPanel>
        <TextBlock Classes="value" Text="{Binding Content.SelectedDetails}"
                   Foreground="{StaticResource SpectraTextMuted}"
                   TextTrimming="CharacterEllipsis" />
        <!-- What the FILE says, read from its own header rather than by
             decoding it. Absent rather than blank while the read is in
             flight. -->
        <TextBlock Classes="micro" Text="{Binding Content.SelectedExtra}"
                   IsVisible="{Binding Content.SelectedExtra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>

    <!-- Selection is the ACCENT, which in this shell means selection and
         nothing else. Declared after the hover rule so a selected tile stays
         selected-looking under the pointer. -->
    <Style Selector="Border.tile.selected">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <!-- A crumb is a word you press, not a control: no fill at rest, and the
         path reads as one string until the pointer is over a segment. -->
    <Style Selector="Button.crumb">
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="Button.crumb:pointerover">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>

    <!-- Dense flat rows, the same idiom as the scene tree: a list of names is a
         list, and a bordered tile per row costs three times the height for no
         more information. -->
    <Style Selector="ListBox.contentlist">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="ListBox.contentlist ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>

    <Style Selector="Border.detailstrip">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
    </Style>
  </UserControl.Styles>
</UserControl>
