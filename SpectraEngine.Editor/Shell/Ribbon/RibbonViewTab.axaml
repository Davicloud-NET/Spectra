<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.Ribbon.RibbonViewTab"
             x:DataType="shell:ShellModel">

  <!-- View page: changes how you look at the level, never the level.
       Every Tag is a roster id in RibbonLayout. -->

  <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

    <StackPanel Classes="ribbongroup">
      <StackPanel Classes="rrow" Orientation="Horizontal" Spacing="1">
        <Button Classes="rbig" Tag="camera.frame" Click="OnRibbonItemClick"
                IsEnabled="{Binding HasSelection}"
                ToolTip.Tip="Fit the selection in the view.  F">
          <Panel>
            <Border Classes="sheen" />
            <StackPanel Classes="rbigstack">
              <Path Classes="icon-lg" Data="{StaticResource IconLgFrame}" />
              <TextBlock Text="Selection" />
            </StackPanel>
          </Panel>
        </Button>

        <Button Classes="rbig" Tag="camera.frameall" Click="OnRibbonItemClick"
                ToolTip.Tip="Fit every spatial node in the scene in the view.">
          <Panel>
            <Border Classes="sheen" />
            <StackPanel Classes="rbigstack">
              <Path Classes="icon-lg" Data="{StaticResource IconLgFrameAll}" />
              <TextBlock Text="Everything" />
            </StackPanel>
          </Panel>
        </Button>
      </StackPanel>
      <TextBlock Classes="ribbongroupcaption" Text="Frame" />
    </StackPanel>

    <Border Classes="ribbonrule" />

    <!-- Three set verbs, not a cycle: a cycle against a stale snapshot lands
         on the wrong mode. Buttons with Classes.active, not RadioButtons: a
         two-way toggle bound to engine state flickers when the snapshot
         corrects it. -->
    <StackPanel Classes="ribbongroup">
      <StackPanel Classes="rrow" Orientation="Horizontal">
        <StackPanel Classes="rcol">
          <Button Classes="rsmall rradio" Tag="grid.auto" Classes.active="{Binding GridAuto}"
                  Click="OnRibbonItemClick"
                  ToolTip.Tip="Show the ground grid during move and resize gestures only.">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconRadio}" />
                <Path Classes="mark dot" Data="{StaticResource IconRadioDot}" />
              </Panel>
              <TextBlock Text="Auto" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="rsmall rradio" Tag="grid.on" Classes.active="{Binding GridOn}"
                  Click="OnRibbonItemClick" ToolTip.Tip="Always draw the ground grid.">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconRadio}" />
                <Path Classes="mark dot" Data="{StaticResource IconRadioDot}" />
              </Panel>
              <TextBlock Text="Always" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="rsmall rradio" Tag="grid.off" Classes.active="{Binding GridOff}"
                  Click="OnRibbonItemClick" ToolTip.Tip="Never draw the ground grid.">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconRadio}" />
                <Path Classes="mark dot" Data="{StaticResource IconRadioDot}" />
              </Panel>
              <TextBlock Text="Off" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <TextBlock Classes="ribbongroupcaption" Text="Ground grid" />
    </StackPanel>

    <Border Classes="ribbonrule" />

    <StackPanel Classes="ribbongroup">
      <StackPanel Classes="rrow" Orientation="Horizontal" Spacing="1">
        <StackPanel Classes="rcol ragged">
          <Button Classes="rsmall rcheck" Tag="overlay.wireframe"
                  Classes.active="{Binding DebugWireframe}" Click="OnRibbonItemClick"
                  ToolTip.Tip="Draw every triangle as line edges.  F1">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconCheckBox}" />
                <Path Classes="mark" Data="{StaticResource IconCheckTick}" />
              </Panel>
              <TextBlock Text="Wireframe" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="rsmall rcheck" Tag="overlay.vertices"
                  Classes.active="{Binding DebugVertices}" Click="OnRibbonItemClick"
                  ToolTip.Tip="Mark every CSG polygon vertex, which surfaces welds and snaps.  F2">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconCheckBox}" />
                <Path Classes="mark" Data="{StaticResource IconCheckTick}" />
              </Panel>
              <TextBlock Text="Vertices" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="rsmall rcheck" Tag="overlay.bounds"
                  Classes.active="{Binding DebugAabbs}" Click="OnRibbonItemClick"
                  ToolTip.Tip="Box every brush and mesh in its world bounds.  F3">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconCheckBox}" />
                <Path Classes="mark" Data="{StaticResource IconCheckTick}" />
              </Panel>
              <TextBlock Text="Bounds" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Classes="rcol ragged">
          <Button Classes="rsmall rcheck" Tag="overlay.normals"
                  Classes.active="{Binding DebugNormals}" Click="OnRibbonItemClick"
                  ToolTip.Tip="Draw an arrow along every outward face normal.  F4">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconCheckBox}" />
                <Path Classes="mark" Data="{StaticResource IconCheckTick}" />
              </Panel>
              <TextBlock Text="Normals" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="rsmall rcheck" Tag="overlay.axes"
                  Classes.active="{Binding DebugSceneGraph}" Click="OnRibbonItemClick"
                  ToolTip.Tip="Draw each node's axes and its line to its parent.  F5">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <Path Classes="markbox" Data="{StaticResource IconCheckBox}" />
                <Path Classes="mark" Data="{StaticResource IconCheckTick}" />
              </Panel>
              <TextBlock Text="Node axes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <TextBlock Classes="ribbongroupcaption" Text="Overlays" />
    </StackPanel>

  </StackPanel>
</UserControl>
