<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.OutputPanel"
             x:DataType="shell:ShellModel"
             Background="{StaticResource SpectraBgPanel}">

  <UserControl.Resources>
    <!-- A line that names a place. A button, so a click opens the place and
         the keyboard reaches the row. Same geometry as the plain row. -->
    <DataTemplate x:Key="PlacedRow" x:DataType="shell:OutputEntry">
      <Button Classes="outrow" Click="OnLineClicked"
              IsHitTestVisible="{Binding HasPlace}" Focusable="{Binding HasPlace}"
              ToolTip.Tip="{Binding PlaceTip}">
        <Grid Margin="8,0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="OutputTime" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <!-- Room for a count on every row, so the places end in one column. -->
            <ColumnDefinition Width="Auto" MinWidth="34" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Classes="value" VerticalAlignment="Top"
                     Margin="0,2,0,0"
                     Foreground="{StaticResource SpectraTextDisabled}"
                     Text="{Binding TimeLabel}" />
          <TextBlock Grid.Column="1" Classes="line" Text="{Binding Text}"
                     Foreground="{Binding SeverityBrush}"
                     TextWrapping="Wrap" />
          <!-- Quieter than the text, and to its right: where the line came from. -->
          <TextBlock Grid.Column="2" Classes="value place" VerticalAlignment="Top"
                     Margin="0,2,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis"
                     Text="{Binding PlaceLabel}" />
          <TextBlock Grid.Column="3" Classes="value" VerticalAlignment="Top" HorizontalAlignment="Right"
                     Margin="0,2,0,0"
                     Foreground="{StaticResource SpectraTextDisabled}"
                     Text="{Binding CountLabel}" />
        </Grid>
      </Button>
    </DataTemplate>

    <!-- One call under an error. Its first column is as wide as the time
         above it, so the call starts under the error's text. -->
    <DataTemplate x:Key="CallRow" x:DataType="shell:OutputFrame">
      <Button Classes="outrow" Click="OnCallClicked" ToolTip.Tip="{Binding Tip}">
        <Grid Margin="8,0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="OutputTime" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Classes="value call" Text="{Binding Label}"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6" ColumnSpacing="6">
      <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center"
                 Text="{Binding Output.HistoryLabel}" />
      <Button Grid.Column="1" Classes="ghost" Click="OnClearClicked" ToolTip.Tip="Clear the output">
        <Path Classes="icon" Data="{StaticResource IconClear}" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <!-- Tab stops in the list once. Up and Down walk the rows that open something. -->
      <ItemsControl Name="Rows" ItemsSource="{Binding Output.Entries}" Margin="0,0,0,6"
                    KeyboardNavigation.TabNavigation="Once"
                    KeyDown="OnRowsKeyDown" GotFocus="OnRowGotFocus">
        <ItemsControl.ItemTemplate>
          <shell:OutputRowTemplate Placed="{StaticResource PlacedRow}">
            <shell:OutputRowTemplate.Plain>
              <DataTemplate x:DataType="shell:OutputEntry">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0" ColumnSpacing="8">
                  <!-- Top margin 2: lines the 11px mono time up with the 12px text baseline. -->
                  <TextBlock Grid.Column="0" Classes="value" VerticalAlignment="Top"
                             Margin="0,2,0,0"
                             Foreground="{StaticResource SpectraTextDisabled}"
                             Text="{Binding TimeLabel}" />
                  <TextBlock Grid.Column="1" Classes="line" Text="{Binding Text}"
                             Foreground="{Binding SeverityBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Classes="value" VerticalAlignment="Top"
                             Margin="0,2,0,0"
                             Foreground="{StaticResource SpectraTextDisabled}"
                             Text="{Binding CountLabel}" />
                </Grid>
              </DataTemplate>
            </shell:OutputRowTemplate.Plain>

            <shell:OutputRowTemplate.WithCalls>
              <DataTemplate x:DataType="shell:OutputEntry">
                <StackPanel Grid.IsSharedSizeScope="True">
                  <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlacedRow}"
                                  HorizontalContentAlignment="Stretch" />
                  <StackPanel x:DataType="shell:OutputStack" DataContext="{Binding Stack}">
                    <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource CallRow}" />
                    <Button Classes="outrow" Click="OnFoldClicked" IsVisible="{Binding CanFold}">
                      <Grid Margin="8,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="OutputTime" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Classes="value call" Text="{Binding FoldLabel}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </shell:OutputRowTemplate.WithCalls>
          </shell:OutputRowTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBlock.line">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- A row that opens something: no chrome of its own, the hover of the
         editor's other rows, and nothing that moves when it is pressed. -->
    <Style Selector="Button.outrow">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border BorderBrush="{StaticResource SpectraAccent}" BorderThickness="1" />
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.outrow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.outrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="Button.outrow:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.outrow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
    </Style>

    <Style Selector="Button.outrow TextBlock.place">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="Button.outrow:pointerover TextBlock.place">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.outrow TextBlock.call">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="Margin" Value="12,1,0,1" />
    </Style>
    <Style Selector="Button.outrow:pointerover TextBlock.call">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
  </UserControl.Styles>
</UserControl>
