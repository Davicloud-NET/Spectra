<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.EntityPickerView">

  <!-- Fills the target text box rather than replacing it: a wildcard or a name
       not in the scene yet is a legal target no list can offer. -->
  <Border Classes="palette" Width="260">
    <DockPanel>
      <TextBox x:Name="Query" DockPanel.Dock="Top" Classes="field"
               PlaceholderText="Search this scene" />

      <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Classes="palettefoot"
                 IsVisible="False" TextWrapping="Wrap" />

      <ListBox x:Name="Rows" Classes="palettelist" MaxHeight="300">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="shell:EntityPickerRow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Classes="palettechord" Text="{Binding ClassName}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         MaxWidth="110" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
