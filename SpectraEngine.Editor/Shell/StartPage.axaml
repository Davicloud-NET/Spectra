<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.StartPage"
             Background="{StaticResource SpectraBgApp}">

  <!--
    Shown until a project is open. No engine session exists yet.

    Laid out like the editor it leads to: two tiles with the same margins and
    gap, so the window does not jump when a project opens.
  -->

  <UserControl.Resources>
    <!-- Shared by every recent row; DataContext comes from the row that
         opened it. Remove only forgets the entry, nothing on disk changes. -->
    <ContextMenu x:Key="RecentMenu" x:DataType="shell:RecentProjectRow">
      <MenuItem Header="Open" Click="OnRecentMenuOpen" />
      <MenuItem Header="Show in Explorer" Click="OnRecentMenuReveal" />
      <Separator />
      <MenuItem Header="Remove from list" InputGesture="Delete" Click="OnRecentMenuForget" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The row fill is on the item's presenter; Border.recent draws the rule. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#00FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <!-- Without the pressed pair Fluent's own :pressed trigger wins the tie
         and a click flashes the stock grey. -->
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <!-- A recent project: a ruled strip, like a scene tree row but taller. -->
    <Style Selector="Border.recent">
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBoxItem:nth-child(2n) Border.recent">
      <Setter Property="Background" Value="{StaticResource SpectraRowAlternate}" />
    </Style>
    <Style Selector="TextBlock.recentname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.recentmeta">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.recent Path.rowglyph">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
    </Style>

    <!-- A project whose folder is gone stays listed, greyed out. -->
    <Style Selector="Border.missing TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Border.missing Path.rowglyph">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
    </Style>

    <!-- The selected row is a solid accent fill, so everything on it is white.
         After the missing rules, so a selected missing row stays readable. -->
    <Style Selector="ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextOnAccent}" />
    </Style>
    <Style Selector="ListBoxItem:selected Path.icon">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextOnAccent}" />
    </Style>

    <!-- Row actions show under the pointer and on the selected row. Opacity,
         not IsVisible, so the row's columns never reflow. -->
    <Style Selector="Button.rowaction">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.rowaction, ListBoxItem:selected Button.rowaction">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- The three ways in: cells of one tray, each a glyph, a name and a line
         saying what it does. -->
    <Style Selector="Button.startaction">
      <Setter Property="Height" Value="54" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.startaction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.startaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    </Style>
    <Style Selector="Button.startaction:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlActive}" />
    </Style>
    <Style Selector="Button.startaction TextBlock.actionname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.startaction TextBlock.actionhint">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.startaction:pointerover Path.icon-lg">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>

    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <!-- Same margins, column and gap as the editor grid in MainWindow. -->
  <Grid ColumnDefinitions="288,7,*" Margin="6,7,6,0">

    <Border Grid.Column="0" Classes="tile">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="band">
          <TextBlock Classes="bandtitle" Text="Start" />
        </Border>

        <StackPanel Margin="10" Spacing="14">
          <!-- The tray the ribbon uses: one outline, a line between cells. -->
          <Border Classes="rtray">
            <StackPanel Classes="rcol">
              <Button Classes="startaction" Click="OnNewProjectClicked">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Path Grid.Column="0" Classes="icon-lg" Data="{StaticResource IconLgNewProject}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="actionname" Text="New project" />
                    <TextBlock Classes="actionhint" Text="A new folder that starts on a baseplate" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="startaction" Click="OnOpenProjectClicked">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Path Grid.Column="0" Classes="icon-lg" Data="{StaticResource IconLgOpenFolder}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="actionname" Text="Open project" />
                    <TextBlock Classes="actionhint" Text="Pick a project's folder" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="startaction" Click="OnOpenMapClicked">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Path Grid.Column="0" Classes="icon-lg" Data="{StaticResource IconLgMap}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="actionname" Text="Open a level on its own" />
                    <TextBlock Classes="actionhint" Text="A level folder outside any project" />
                  </StackPanel>
                </Grid>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Classes="help" Margin="2,0"
                     Text="You can also drop a project or a level folder anywhere on this window." />

          <!-- Shown only while there are no recent projects. -->
          <TextBlock x:Name="FirstRunHelp" Classes="help" Margin="2,0"
                     Text="A project is an ordinary folder holding your Assets, Levels and Scripts. Nothing in it is a database, and everything you author is text you can read." />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="2" Classes="tile">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="band">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="bandtitle" Text="Recent projects" />
            <TextBlock x:Name="CountLabel" Classes="value"
                       Foreground="{StaticResource SpectraTextMuted}" />
          </StackPanel>
        </Border>

        <!-- Hidden while the list is short enough to read at a glance. -->
        <Border x:Name="FilterRow" DockPanel.Dock="Top" Padding="8,7"
                BorderBrush="{StaticResource SpectraBorderSoft}" BorderThickness="0,0,0,1">
          <TextBox x:Name="FilterBox" Classes="field"
                   PlaceholderText="Filter by name or folder. Enter opens the first match."
                   TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown" />
        </Border>

        <!-- Outside the scroll so they stay put. Hidden for a single row.
             Columns match the row template's. -->
        <Border x:Name="ColumnHeadings" DockPanel.Dock="Top" Height="24"
                BorderBrush="{StaticResource SpectraBorderSoft}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="28,*,1.7*,104,60" Margin="10,0,6,0">
            <TextBlock Grid.Column="1" Classes="colhead" Text="Name" />
            <TextBlock Grid.Column="2" Classes="colhead" Text="Folder" Margin="10,0" />
            <TextBlock Grid.Column="3" Classes="colhead" Text="Last opened" />
          </Grid>
        </Border>

        <!-- Empty state: a first launch, or a filter that matched nothing. -->
        <StackPanel x:Name="EmptyState" DockPanel.Dock="Top" Margin="16,22,16,0"
                    MaxWidth="480" HorizontalAlignment="Left" Spacing="12">
          <TextBlock x:Name="EmptyTitle" Text="Nothing open yet."
                     FontSize="{StaticResource SpectraFontTitle}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource SpectraTextEmphasis}" />
          <TextBlock x:Name="EmptyLabel" Classes="help"
                     Text="Make a project to start building, or open one you already have. Projects you open appear in this list." />
          <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" MinWidth="130" Content="New project" Click="OnNewProjectClicked" />
            <Button Classes="secondary" MinWidth="130" Content="Open project" Click="OnOpenProjectClicked" />
          </StackPanel>
        </StackPanel>

        <ListBox x:Name="RecentList"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 KeyDown="OnRecentKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="shell:RecentProjectRow">
              <!-- One click opens. The two buttons are the other things a row
                   can do, so nothing needs a right-click to be found. -->
              <Border Classes="recent"
                      Classes.missing="{Binding IsMissing}"
                      ContextMenu="{StaticResource RecentMenu}"
                      Tapped="OnRecentTapped"
                      ToolTip.Tip="{Binding Path}">
                <Grid ColumnDefinitions="28,*,1.7*,104,60" Margin="10,0,6,0">
                  <Path Grid.Column="0" Classes="icon rowglyph" HorizontalAlignment="Left"
                        Data="{StaticResource IconGroup}" />
                  <TextBlock Grid.Column="1" Classes="recentname" Text="{Binding Name}" />
                  <TextBlock Grid.Column="2" Classes="recentmeta" Text="{Binding Location}" Margin="10,0" />
                  <TextBlock Grid.Column="3" Classes="recentmeta" Text="{Binding OpenedLabel}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                              HorizontalAlignment="Right">
                    <Button Classes="ghost rowaction" Click="OnRowRevealClicked"
                            ToolTip.Tip="Show in Explorer">
                      <Path Classes="icon" Data="{StaticResource IconOpenFolder}" />
                    </Button>
                    <Button Classes="ghost rowaction" Click="OnRowForgetClicked"
                            ToolTip.Tip="Remove from this list. Nothing on disk changes.">
                      <Path Classes="icon" Data="{StaticResource IconClear}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
