<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
             x:Class="SpectraEngine.Editor.Shell.StartPage"
             Background="{StaticResource SpectraBgApp}">

  <!-- Shown until a project is open. No engine session exists yet. -->

  <UserControl.Resources>
    <!-- Shared by every recent row; DataContext comes from the row that
         opened it. Remove only forgets the entry, nothing on disk changes. -->
    <ContextMenu x:Key="RecentMenu" x:DataType="shell:RecentProjectRow">
      <MenuItem Header="Open" Click="OnRecentMenuOpen" />
      <MenuItem Header="Show in Explorer" Click="OnRecentMenuReveal" />
      <Separator />
      <MenuItem Header="Remove from list" InputGesture="Delete" Click="OnRecentMenuForget" />
    </ContextMenu>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Flat list rows: a fill on hover and selection, no border, no card. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <!-- Without the pressed pair Fluent's own :pressed trigger wins the tie
         and a click flashes the stock grey. -->
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraRowSelected}" />
    </Style>

    <Style Selector="Button.action">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlPressed}" />
    </Style>
    <Style Selector="Button.action TextBlock">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.action Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource SpectraAccent}" />
    </Style>

    <Style Selector="TextBlock.colhead">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A project whose folder is gone stays listed, greyed out. -->
    <Style Selector="Border.missing TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
  </UserControl.Styles>

  <!-- No header here: the window's own bar sits directly above this page. -->
  <DockPanel>

    <Border DockPanel.Dock="Left" Width="236"
            Background="{StaticResource SpectraBgPanel}"
            BorderBrush="{StaticResource SpectraBorderStrong}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="8,10" Spacing="1">
          <Button Classes="action" Click="OnNewProjectClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconNewProject}" />
              <TextBlock Text="New project" />
            </StackPanel>
          </Button>
          <Button Classes="action" Click="OnOpenProjectClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconOpenFolder}" />
              <TextBlock Text="Open project" />
            </StackPanel>
          </Button>
          <Button Classes="action" Click="OnOpenMapClicked">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource IconMap}" />
              <TextBlock Text="Open a level on its own" />
            </StackPanel>
          </Button>

          <!-- Shown only while there are no recent projects. -->
          <StackPanel x:Name="FirstRunHelp" Spacing="9">
            <Border Height="1" Background="{StaticResource SpectraBorderSoft}" Margin="8,12,4,3" />
            <TextBlock TextWrapping="Wrap" Margin="8,0,4,0"
                       FontSize="{StaticResource SpectraFontSecondary}"
                       Foreground="{StaticResource SpectraTextMuted}"
                       Text="A project is an ordinary folder holding your Assets, Levels and Scripts. Nothing in it is a database, and everything you author is text you can read." />
            <TextBlock TextWrapping="Wrap" Margin="8,0,4,0"
                       FontSize="{StaticResource SpectraFontSecondary}"
                       Foreground="{StaticResource SpectraTextMuted}"
                       Text="You can also drop a project or a level folder anywhere on this window." />
          </StackPanel>
      </StackPanel>
    </Border>

    <DockPanel Margin="14,10,14,12">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Text="Recent projects"
                   FontSize="{StaticResource SpectraFontBase}"
                   Foreground="{StaticResource SpectraTextBody}"
                   VerticalAlignment="Center" />
        <!-- Hidden while the list is short enough to read at a glance. -->
        <TextBox Grid.Column="2" x:Name="FilterBox" Classes="field" Width="180"
                 PlaceholderText="Filter"
                 TextChanged="OnFilterChanged" KeyDown="OnFilterKeyDown" />
      </Grid>

      <!-- Outside the scroll so they stay put. Hidden for a single row. -->
      <StackPanel x:Name="ColumnHeadings" DockPanel.Dock="Top">
        <Grid ColumnDefinitions="*,1.6*,Auto" Margin="8,0,10,4">
          <TextBlock Grid.Column="0" Classes="colhead" Text="Name" />
          <TextBlock Grid.Column="1" Classes="colhead" Text="Location" />
          <TextBlock Grid.Column="2" Classes="colhead" Text="Opened" />
        </Grid>
        <Border Height="1" Background="{StaticResource SpectraBorderSoft}" Margin="0,0,0,2" />
      </StackPanel>

      <!-- Empty state. Repeats the three actions in the main column. -->
      <StackPanel x:Name="EmptyState" DockPanel.Dock="Top" Margin="8,26,8,0"
                  MaxWidth="480" HorizontalAlignment="Left" Spacing="14">
        <TextBlock x:Name="EmptyTitle" Text="Nothing open yet."
                   FontSize="{StaticResource SpectraFontTitle}"
                   Foreground="{StaticResource SpectraTextEmphasis}" />
        <TextBlock x:Name="EmptyLabel" TextWrapping="Wrap"
                   FontSize="{StaticResource SpectraFontSecondary}"
                   Foreground="{StaticResource SpectraTextMuted}"
                   Text="Make a project to start building, or open one you already have. Projects you open appear in this list." />
        <StackPanel x:Name="EmptyActions" Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" MinWidth="130" Content="New project" Click="OnNewProjectClicked" />
          <Button Classes="secondary" MinWidth="130" Content="Open project" Click="OnOpenProjectClicked" />
        </StackPanel>
      </StackPanel>

      <ListBox x:Name="RecentList"
               Background="Transparent"
               BorderThickness="0"
               Padding="0"
               DoubleTapped="OnRecentActivated"
               KeyDown="OnRecentKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:RecentProjectRow">
            <Border Height="26" Background="Transparent"
                    Classes.missing="{Binding IsMissing}"
                    ContextMenu="{StaticResource RecentMenu}"
                    ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="*,1.6*,Auto" Margin="8,0,10,0">
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           FontSize="{StaticResource SpectraFontBase}"
                           Foreground="{StaticResource SpectraTextEmphasis}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Location}"
                           FontSize="{StaticResource SpectraFontSmall}"
                           Foreground="{StaticResource SpectraTextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="10,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding OpenedLabel}"
                           FontSize="{StaticResource SpectraFontSmall}"
                           Foreground="{StaticResource SpectraTextMuted}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
