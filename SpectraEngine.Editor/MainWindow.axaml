<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:SpectraEngine.Editor.Viewport"
        xmlns:local="clr-namespace:SpectraEngine.Editor"
        xmlns:shell="clr-namespace:SpectraEngine.Editor.Shell"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dm="clr-namespace:Dock.Model.Avalonia.Controls;assembly=Dock.Model.Avalonia"
        x:Class="SpectraEngine.Editor.MainWindow"
        x:DataType="shell:ShellModel"
        Title="Spectra Editor"
        Width="1480" Height="920"
        MinWidth="1180" MinHeight="640"
        Background="{StaticResource SpectraBgApp}">

  <!--
    Four rows, none of which overlaps the viewport.

    Airspace: a native viewport is a child window and composites above anything
    Avalonia draws into this window, so no overlay, adorner or managed dock
    float may cross its cell. Popups (menus, flyouts, tooltips, dialogs) are
    real OS windows on Windows and may. A composited viewport has no child
    window and none of this applies. See ViewportLayout.
  -->

  <Window.Styles>
    <Style Selector="TextBlock.docname">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.docproject">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.statusmsg">
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statusmsg.errormsg">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDanger}" />
    </Style>

    <!-- A class, not a local Foreground, which would outrank .overbudget.
         Declared before .overbudget so that one wins on order. -->
    <Style Selector="TextBlock.frametime">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
    </Style>
    <Style Selector="TextBlock.overbudget">
      <Setter Property="Foreground" Value="{StaticResource SpectraWarning}" />
    </Style>

    <!-- Play: a green fill. While playing it is a plain key with an amber
         stop glyph. The disabled rules come last so they win. -->
    <Style Selector="Button.playbtn">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="62" />
      <Setter Property="Padding" Value="12,0,14,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusTray}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="Foreground" Value="{StaticResource SpectraTextOnAccent}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.playbtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraPlayFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraBorderControl}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusTray}" />
    </Style>
    <Style Selector="Button.playbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraPlayFillHover}" />
    </Style>
    <!-- The label needs its own rule: the global TextBlock style beats a
         Foreground inherited from the button. -->
    <Style Selector="Button.playbtn TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextOnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.playbtn Path.playglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraTextOnAccent}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraTextOnAccent}" />
    </Style>
    <Style Selector="Button.playbtn.playing /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    </Style>
    <Style Selector="Button.playbtn.playing:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControlHover}" />
    </Style>
    <Style Selector="Button.playbtn.playing TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
    </Style>
    <Style Selector="Button.playbtn Path.stopglyph">
      <Setter Property="Fill" Value="{StaticResource SpectraMode}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
    </Style>
    <Style Selector="Button.playbtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraBgControl}" />
    </Style>
    <Style Selector="Button.playbtn:disabled Path">
      <Setter Property="Fill" Value="{StaticResource SpectraTextDisabled}" />
      <Setter Property="Stroke" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Button.playbtn:disabled">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>
    <Style Selector="Button.playbtn:disabled TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextDisabled}" />
    </Style>

    <!-- Mode colour round the ribbon during play, so the greyed Insert
         group reads as suspended, not broken. -->
    <Style Selector="Border.cmdbar">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.cmdbar.playing">
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
    </Style>

    <!-- One chip per latched debug overlay; clicking it turns that overlay off. -->
    <Style Selector="Button.overlaychip">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.overlaychip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="{StaticResource SpectraMotionFast}"
                           Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.overlaychip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SpectraControlHover}" />
    </Style>
    <Style Selector="Button.overlaychip TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSmall}" />
    </Style>

    <!-- The drop overlay. Composited sessions only: over a native child it
         would be composited away.

         Amber (SpectraMode), not the accent: the accent means selection, and a
         drop target selects nothing. The refusing arm shares the hue and is
         told apart by icon and words.

         Must not be hit-test visible. It is always in the tree at opacity zero,
         and would otherwise take DragOver from the viewport so the drop never
         lands. -->
    <Style Selector="Border.dropoverlay">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="Background" Value="{StaticResource SpectraDropWash}" />
      <!-- Fades in and out; nothing here follows the cursor, so a transition
           is safe. One duration both ways: a faster exit would depend on the
           order Avalonia reverts setters, which it does not guarantee. -->
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="{StaticResource SpectraMotionFast}"
                            Easing="{StaticResource SpectraEaseOut}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dropoverlay.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Opaque: a translucent label is unreadable over an arbitrary render. -->
    <Style Selector="Border.dropchip">
      <Setter Property="Background" Value="{StaticResource SpectraBgApp}" />
      <Setter Property="BorderBrush" Value="{StaticResource SpectraMode}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource SpectraRadiusControl}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- Each sets Foreground explicitly: the global TextBlock style beats a
         colour inherited from the chip. Keep the class in the selector. -->
    <Style Selector="Border.dropchip Path.dropicon">
      <Setter Property="Stroke" Value="{StaticResource SpectraMode}" />
    </Style>
    <Style Selector="Border.dropchip TextBlock.dropheadline">
      <Setter Property="Foreground" Value="{StaticResource SpectraMode}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontBase}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Mono: this is the content-relative path, a value. -->
    <Style Selector="Border.dropchip TextBlock.dropsubject">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextEmphasis}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.dropchip TextBlock.dropreason">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextBody}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Secondary line; shown on every accepting material drag. -->
    <Style Selector="Border.dropchip TextBlock.drophint">
      <Setter Property="Foreground" Value="{StaticResource SpectraTextMuted}" />
      <Setter Property="FontSize" Value="{StaticResource SpectraFontMicro}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- Ribbon styles live in Theme/Controls.axaml: the ribbon flyout is a
         popup, a separate visual root that Window.Styles does not reach. -->
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Top row: menus, the ribbon's page tabs, the document, history and
         Play. Everything a collapsed ribbon must not hide lives here.
         ZIndex: the open tab hangs a pixel over the ribbon page below. -->
    <Border x:Name="RibbonStrip" Grid.Row="0" Classes="ribbonstrip" ZIndex="1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">

        <!-- 6 + the Menu's 4 padding = x 10, the left rail the other bars use. -->
        <Menu Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0">

          <MenuItem Header="_File">
            <MenuItem Header="_New project..." Click="OnNewProjectClicked" />
            <MenuItem Header="_Open project..." Click="OnOpenProjectClicked" />
            <!-- Filled in code from the recents list, before the clear entry. -->
            <MenuItem Header="Recent p_rojects" x:Name="RecentProjectsMenu">
              <MenuItem Header="(nothing yet)" IsEnabled="False" x:Name="RecentProjectsEmptyItem" />
              <Separator x:Name="RecentProjectsSeparator" />
              <MenuItem Header="Clear list" Click="OnClearRecentsClicked" x:Name="RecentProjectsClearItem" />
            </MenuItem>
            <MenuItem Header="_Close project" Click="OnCloseProjectClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="New _level" InputGesture="Ctrl+N" Click="OnNewMapClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Open _level..." InputGesture="Ctrl+O" Click="OnOpenMapClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" IsEnabled="{Binding HasSession}" />
            <MenuItem Header="Save _as..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" IsEnabled="{Binding HasSession}" />
            <Separator />
            <!-- Cooks, then mounts the pack alone and strict. The editor itself
                 resolves loose files above the pack and would hide a missing
                 cooked asset. -->
            <MenuItem Header="_Validate cooked content" Click="OnValidateCookedClicked"
                      IsEnabled="{Binding CanValidateCooked}"
                      ToolTip.Tip="Cook this project and check the pack resolves with nothing else mounted." />
            <Separator />
            <MenuItem Header="E_xit" Click="OnExitClicked" />
          </MenuItem>

          <MenuItem Header="_Edit" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUndo}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRedo}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <!-- Here, not on the ribbon: the engine's Ctrl+A stands down while a
                 camera has the movement keys, and the ribbon's Arrange group
                 is disabled with nothing selected. -->
            <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="OnSelectAllClicked" />
            <MenuItem Header="Deselect all" InputGesture="Escape" Click="OnClearSelectionClicked" IsEnabled="{Binding HasSelection}" />
            <Separator />
            <MenuItem Header="Move tool" InputGesture="W" Click="OnMoveClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconMove}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Rotate tool" InputGesture="E" Click="OnRotateClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconRotate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Size tool" InputGesture="R" Click="OnResizeClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconResize}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Snap to grid" InputGesture="G" Click="OnSnapClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGrid}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Finer grid" InputGesture="OemOpenBrackets" Click="OnSnapFinerClicked" />
            <MenuItem Header="Coarser grid" InputGesture="OemCloseBrackets" Click="OnSnapCoarserClicked" />
            <Separator />
            <MenuItem Header="{Binding OrientationMenuLabel}" InputGesture="X" Click="OnOrientationClicked" />
            <MenuItem Header="{Binding GizmoStyleMenuLabel}" InputGesture="Y" Click="OnStyleClicked" />
          </MenuItem>

          <!-- Insert comes first: it is what a newcomer looks for. -->
          <MenuItem Header="_Object" IsEnabled="{Binding HasSession}">
            <MenuItem Header="Insert block" InputGesture="Ctrl+D1" Click="OnInsertWorldBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-world" Data="{StaticResource IconBrushWorld}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert part" InputGesture="Ctrl+D2" Click="OnInsertPartBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-part" Data="{StaticResource IconBrushPart}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert cut" InputGesture="Ctrl+D3" Click="OnInsertSubtractiveBrushClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-cut" Data="{StaticResource IconBrushSubtractive}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert light" InputGesture="Ctrl+D4" Click="OnInsertLightClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon kind-light" Data="{StaticResource IconLight}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert surface light" Click="OnInsertSurfaceLightClicked" IsEnabled="{Binding !IsPlaying}"
                      ToolTip.Tip="A lit panel flat on the surface you are looking at, parented to it."><MenuItem.Icon><Path Classes="icon menuicon kind-light" Data="{StaticResource IconLight}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Insert empty group" Click="OnInsertGroupClicked" IsEnabled="{Binding !IsPlaying}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroup}" /></MenuItem.Icon></MenuItem>

            <!-- Entries are built in code when the submenu opens, from the
                 session's entity catalogue. Not an ItemsSource: that needs a
                 ControlTheme over Fluent's MenuItem, and gets blank rows when
                 wrong. Hidden when the catalogue is empty. -->
            <MenuItem x:Name="InsertEntityMenu" Header="Insert entity"
                      IsVisible="{Binding HasEntityClasses}"
                      IsEnabled="{Binding !IsPlaying}"
                      SubmenuOpened="OnInsertEntityMenuOpened">
              <MenuItem.Icon><Path Classes="icon menuicon kind-entity" Data="{StaticResource IconEntity}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Duplicate" InputGesture="Ctrl+D" Click="OnDuplicateClicked" IsEnabled="{Binding CanEditSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDuplicate}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Delete" InputGesture="Delete" Click="OnDeleteClicked" IsEnabled="{Binding CanEditSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconDelete}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Group" InputGesture="Ctrl+G" Click="OnGroupClicked" IsEnabled="{Binding CanEditSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Ungroup" InputGesture="Ctrl+Shift+G" Click="OnUngroupClicked" IsEnabled="{Binding CanEditSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconUngroupNodes}" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Convert block / part" InputGesture="Ctrl+T" Click="OnToggleBrushKindClicked" IsEnabled="{Binding CanEditSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconConvertKind}" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Frame in viewport" InputGesture="F" Click="OnFrameClicked" IsEnabled="{Binding HasSelection}"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconFrame}" /></MenuItem.Icon></MenuItem>
            <!-- Beside Frame selection, not under View: keep the pair together. -->
            <MenuItem Header="Frame everything" InputGesture="Shift+F" Click="OnFrameAllClicked"><MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconFrameAll}" /></MenuItem.Icon></MenuItem>
          </MenuItem>

          <MenuItem Header="_View" IsEnabled="{Binding HasSession}">
            <!-- Panels first: this menu is the only way to reopen a closed one. -->
            <!-- Workspace presets. -->
            <MenuItem Header="Workspace">
              <MenuItem Header="Compact" ToggleType="Radio"
                        IsChecked="{Binding IsCompactWorkspace, Mode=OneWay}"
                        Click="OnUseCompactWorkspace" />
              <MenuItem Header="Expanded" ToggleType="Radio"
                        IsChecked="{Binding IsExpandedWorkspace, Mode=OneWay}"
                        Click="OnUseExpandedWorkspace" />
              <Separator />
              <MenuItem Header="Maximise viewport" InputGesture="F11"
                        Click="OnToggleMaximiseViewport" />
              <MenuItem Header="Bottom panel" InputGesture="Ctrl+OemTilde"
                        ToggleType="CheckBox"
                        IsChecked="{Binding IsDrawerOpen, Mode=OneWay}"
                        Click="OnToggleBottomDrawer" />
              <MenuItem Header="Diagnostics readouts" ToggleType="CheckBox"
                        IsChecked="{Binding ShowDiagnostics, Mode=OneWay}"
                        Click="OnToggleDiagnostics" />
            </MenuItem>

            <!-- Three set verbs, like Grid below. The key flips between hidden
                 and the split last used, so it is on the heading. -->
            <MenuItem Header="Logic view" InputGesture="Ctrl+L">
              <MenuItem Header="Below the viewport" ToggleType="Radio"
                        IsChecked="{Binding IsLogicBelow, Mode=OneWay}"
                        Click="OnShowLogicBelow" />
              <MenuItem Header="Beside the viewport" ToggleType="Radio"
                        IsChecked="{Binding IsLogicBeside, Mode=OneWay}"
                        Click="OnShowLogicBeside" />
              <MenuItem Header="Hidden" ToggleType="Radio"
                        IsChecked="{Binding IsLogicHidden, Mode=OneWay}"
                        Click="OnHideLogic" />
            </MenuItem>

            <MenuItem Header="Panels">
              <MenuItem Header="Scene" Click="OnShowScenePanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconGroup}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Levels" Click="OnShowMapsPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconMap}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Properties" Click="OnShowPropertiesPanel" />
              <Separator />
              <MenuItem Header="Content" Click="OnShowContentPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconOpenFolder}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Output" Click="OnShowOutputPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconWarning}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Problems" Click="OnShowProblemsPanel">
                <MenuItem.Icon><Path Classes="icon menuicon" Data="{StaticResource IconWarning}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Console" InputGesture="OemTilde" Click="OnShowConsolePanel" />
            </MenuItem>
            <Separator />

            <!-- Built in code: the pipeline list depends on the renderer. -->
            <MenuItem Header="Renderer" x:Name="RendererMenu" />
            <Separator />
            <MenuItem Header="Wireframe" InputGesture="F1" ToggleType="CheckBox"
                      IsChecked="{Binding DebugWireframe, Mode=OneWay}" Click="OnDebugWireClicked" />
            <MenuItem Header="CSG vertices" InputGesture="F2" ToggleType="CheckBox"
                      IsChecked="{Binding DebugVertices, Mode=OneWay}" Click="OnDebugVerticesClicked" />
            <MenuItem Header="Bounds" InputGesture="F3" ToggleType="CheckBox"
                      IsChecked="{Binding DebugAabbs, Mode=OneWay}" Click="OnDebugAabbsClicked" />
            <MenuItem Header="Face normals" InputGesture="F4" ToggleType="CheckBox"
                      IsChecked="{Binding DebugNormals, Mode=OneWay}" Click="OnDebugNormalsClicked" />
            <MenuItem Header="Node axes" InputGesture="F5" ToggleType="CheckBox"
                      IsChecked="{Binding DebugSceneGraph, Mode=OneWay}" Click="OnDebugSceneGraphClicked" />
            <Separator />
            <!-- Three set verbs, not a cycle; the checkmark follows the engine. -->
            <MenuItem Header="Grid">
              <MenuItem Header="During move and resize" ToggleType="Radio"
                        IsChecked="{Binding GridAuto, Mode=OneWay}" Click="OnGridAutoClicked" />
              <MenuItem Header="Always" ToggleType="Radio"
                        IsChecked="{Binding GridOn, Mode=OneWay}" Click="OnGridOnClicked" />
              <MenuItem Header="Off" ToggleType="Radio"
                        IsChecked="{Binding GridOff, Mode=OneWay}" Click="OnGridOffClicked" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding NavigationMenuLabel}" InputGesture="F7" Click="OnToggleNavigationClicked" />

          </MenuItem>

          <MenuItem Header="_Help">
            <MenuItem Header="Keyboard reference" Click="OnKeyboardReferenceClicked" />
            <Separator />
            <MenuItem Header="{Binding AboutLabel}" IsEnabled="False" />
          </MenuItem>
        </Menu>

        <!-- Page tabs, filled in code from RibbonLayout.Tabs. Bottom-aligned
             and one pixel low, so the open tab covers the page's top border. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,-1"
                    VerticalAlignment="Bottom" IsVisible="{Binding HasSession}">
          <Border Classes="groupsep" Margin="0,0,10,0" />
          <StackPanel x:Name="RibbonTabs" Orientation="Horizontal" Spacing="3" />
        </StackPanel>

        <!-- Shown with no session open, in place of the document cluster. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding !HasSession}">
          <Border Width="10" Height="10"
                  CornerRadius="{StaticResource SpectraRadiusControl}"
                  Background="{StaticResource SpectraAccent}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Spectra Editor" Classes="docname" />
          <TextBlock x:Name="VersionLabel" Classes="value"
                     Foreground="{StaticResource SpectraTextMuted}" />
        </StackPanel>

        <!-- Project and level, the unsaved dot, history, the ribbon pin, Play. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    IsVisible="{Binding HasSession}">
          <TextBlock Classes="docproject" Text="{Binding ProjectName}"
                     IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docproject" Text="/" IsVisible="{Binding HasProject}" />
          <TextBlock Classes="docname" Text="{Binding DocumentName}" />
          <Border Width="6" Height="6" CornerRadius="3"
                  Background="{StaticResource SpectraWarning}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsDocumentDirty}"
                  ToolTip.Tip="Unsaved changes" />
          <Border Classes="cluster" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
              <!-- Tag is the roster id; RibbonLayoutTests reads it. -->
              <Button Classes="seg" Width="28" Padding="0" Tag="history.undo" Focusable="False" Click="OnRibbonStripClick"
                      IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}">
                <Path Classes="icon" Data="{StaticResource IconUndo}" />
              </Button>
              <Border Classes="segsep" />
              <Button Classes="seg" Width="28" Padding="0" Tag="history.redo" Focusable="False" Click="OnRibbonStripClick"
                      IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}">
                <Path Classes="icon" Data="{StaticResource IconRedo}" />
              </Button>
            </StackPanel>
          </Border>
          <!-- The pin: one geometry, rotated per state. -->
          <Button x:Name="RibbonPin" Classes="tool ribbonpin" Click="OnRibbonPinClicked">
            <Path Classes="icon" Data="{StaticResource IconChevronRight}" />
          </Button>
          <Button Classes="playbtn" Classes.playing="{Binding IsPlaying}" Click="OnPlayClicked"
                  IsEnabled="{Binding CanPlay}" ToolTip.Tip="{Binding PlayTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel Width="16" Height="16">
                <Path Classes="icon playglyph" Data="{StaticResource IconPlay}"
                      StrokeThickness="0" IsVisible="{Binding !IsPlaying}" />
                <Path Classes="icon stopglyph" Data="{StaticResource IconStop}"
                      StrokeThickness="0" IsVisible="{Binding IsPlaying}" />
              </Panel>
              <TextBlock Text="{Binding PlayLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The ribbon page. Collapsible, two pages (Build, View). The roster is
         RibbonLayout: every control's Tag is its roster id, no verb is on two
         pages, and RibbonLayoutTests enforces both. -->
    <Panel Grid.Row="1" Margin="6,0" IsVisible="{Binding HasSession}">

      <!-- The page while pinned open. One live instance per page, moved
           between this host and the flyout's. -->
      <Border x:Name="RibbonBody" Classes="ribbonbody cmdbar" Classes.playing="{Binding IsPlaying}">
        <ContentControl x:Name="RibbonInlineHost" />
      </Border>

      <!-- The page while collapsed. A popup, because only a real OS window
           may cross a native viewport. The dismissing click does not pass
           through, so clicking the open tab closes it once. -->
      <Popup x:Name="RibbonFlyout"
             PlacementTarget="{Binding #RibbonStrip}"
             Placement="BottomEdgeAlignedLeft"
             HorizontalOffset="6"
             IsLightDismissEnabled="True">
        <Border Classes="ribbonflyout">
          <ContentControl x:Name="RibbonFlyoutHost" />
        </Border>
      </Popup>

      <!-- Command palette. A popup for the same reason as the flyout.
           Anchored to the top row so it does not cover the scene. -->
      <Popup x:Name="CommandPalettePopup"
             PlacementTarget="{Binding #RibbonStrip}"
             Placement="BottomEdgeAlignedLeft"
             HorizontalOffset="120"
             IsLightDismissEnabled="True">
        <shell:CommandPaletteView x:Name="Palette" />
      </Popup>
    </Panel>

    <!-- Start page or editor. Switched in code: the viewport must leave the
         tree before the editor view hides. -->
    <Panel Grid.Row="2">

      <shell:StartPage x:Name="StartView" />

      <!-- Panels and viewport. No panel's cell intersects the viewport's. A
           composited session moves the viewport into the centre dock. -->
      <!-- Left and right span the full height; the bottom region sits under
           the viewport only. -->
      <Grid x:Name="EditorView" IsVisible="False" Margin="6,7,6,0">

        <!-- Long form: min sizes have no shorthand, and without them a column
             can be dragged to zero width. The 7s are WorkspaceLayout.Gutter. -->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="288" MinWidth="180" />
          <ColumnDefinition Width="7" />
          <ColumnDefinition Width="*" MinWidth="360" />
          <ColumnDefinition Width="7" />
          <ColumnDefinition Width="308" MinWidth="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="7" />
          <RowDefinition Height="236" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Four DockControls: one per side, one under the centre, and one in
             the centre cell that only a composited session shows. A native
             viewport never docks: re-parenting destroys its HWND and the
             session. -->
        <Border Classes="tile" Grid.Column="0" Grid.RowSpan="3" IsVisible="{Binding #LeftDock.IsVisible}">
        <dock:DockControl x:Name="LeftDock"
                          InitializeLayout="True" InitializeFactory="True">
          <!-- Native floats on every root. A managed float is drawn in this
               window's layer and vanishes behind a native viewport. -->
          <dm:RootDock x:Name="LeftRoot" Id="LeftRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #LeftLayout}">
            <dm:ProportionalDock x:Name="LeftLayout" Id="LeftLayout" Orientation="Vertical">
              <!-- Tool content is assigned in code. XAML content of a Tool becomes
                   a deferred template that rebuilds the panel on every layout
                   change; a Control instance survives re-docks and floats. -->
              <!-- CanPin is set from code on every tool: Dock's pinned flyout is
                   drawn in the managed layer, so it only works beside a
                   composited viewport. -->
              <dm:ToolDock x:Name="MapsDock" Id="MapsDock" Alignment="Top" Proportion="0.085">
                <dm:Tool x:Name="MapsTool" Id="Maps" Title="Levels" CanClose="False" CanPin="False" />
              </dm:ToolDock>
              <dm:ProportionalDockSplitter x:Name="MapsSplitter" />
              <dm:ToolDock x:Name="SceneDock" Id="SceneDock" Alignment="Left" Proportion="0.89">
                <dm:Tool x:Name="SceneTool" Id="Scene" Title="Scene" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
        </Border>

        <!-- Splitter: the whole gap between two panels. Do not set Background
             here; a local value outranks the style's :pointerover rule. The
             line that shows on hover is the ink below, lit from code. -->
        <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" Cursor="SizeWestEast"
                      PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #LeftSplitInk}" />
        <Border x:Name="LeftSplitInk" Grid.Column="1" Grid.RowSpan="3" Width="3" CornerRadius="1.5" Classes="splitink"
                HorizontalAlignment="Center" />

        <!-- The viewport pane lives in one of two places per session. Native:
             pinned in this grid cell. Composited: a tool in the DockControl
             below. ViewportLayout.For decides, from the same decision that
             built the viewport.

             Same factory as the other docks, or panels cannot be dragged
             between regions. Hidden until a composited session asks for it. -->
        <Border Classes="tile" Grid.Column="2" Grid.Row="0" IsVisible="{Binding #CenterDock.IsVisible}">
        <dock:DockControl x:Name="CenterDock" IsVisible="False"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="CenterRoot" Id="CenterRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #CenterLayout}">
            <dm:ProportionalDock x:Name="CenterLayout" Id="CenterLayout" Orientation="Vertical">
              <dm:ToolDock x:Name="ViewportDock" Id="ViewportDock" Alignment="Top" Proportion="1">
                <!-- CanClose false: nothing reopens a closed viewport. CanPin is
                     set from code. -->
                <dm:Tool x:Name="ViewportTool" Id="Viewport" Title="Viewport" CanClose="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
        </Border>

        <!-- The view panes: the 3D view and, when it shows, the Logic view.
             One grid, so both travel together into a dock or float. Three
             tracks each way: pane, gutter, pane. ApplyViewArrangement sets
             the lengths, the cells and what shows, and never moves a child:
             re-parenting a native viewport destroys its session. -->
        <Grid x:Name="ViewPanes" Grid.Column="2" Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="0" />
          <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <!-- The pane: header strip plus bezel, one control so the header
             travels with the viewport into a dock or float. -->
        <Grid x:Name="ViewportPane" Grid.Column="0" Grid.Row="0" RowDefinitions="Auto,*">

          <!-- Viewport header: view state in a row above the picture. Beside
               the viewport, not over it, so it works in both session kinds. -->
          <!-- Its own control so the render suite can measure it. -->
          <shell:ViewportHeaderStrip Grid.Row="0" x:Name="HeaderStrip" />

          <!-- The bezel is the padding ring; with no padding the background
               never shows. MinWidth: a zero-width swap chain may not recover,
               and a floated pane has no column minimum behind it. -->
          <Border Grid.Row="1" MinWidth="360" Padding="1"
                  Background="{StaticResource SpectraViewportBezel}">
            <!-- Code inserts the viewport control at index 0, so the overlay
                 below ends up last in the list and draws on top. -->
            <Grid x:Name="ViewportHost">
              <Border Classes="dropoverlay" Classes.shown="{Binding DropVisible}">
                <!-- At the top: a centred chip would cover the drop point. -->
                <Border Classes="dropchip" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="0,16,0,0">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- One glyph, chosen by the prompt: mesh, material or
                           warning. -->
                      <Path Classes="icon dropicon" Data="{Binding DropIcon}" />
                      <TextBlock Classes="dropheadline" Text="{Binding DropHeadline}" />
                      <TextBlock Classes="dropsubject" Text="{Binding DropSubject}"
                                 IsVisible="{Binding DropAccepts}" />
                    </StackPanel>
                    <!-- The refusal sentence, from AssetDropPolicy. -->
                    <TextBlock Classes="dropreason" Text="{Binding DropReason}"
                               IsVisible="{Binding !DropAccepts}" />

                    <!-- What the drop would paint, and the modifier that widens it. -->
                    <TextBlock Classes="drophint" Text="{Binding DropHint}"
                               IsVisible="{Binding DropHasHint}" />
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- The Logic pane, built like the viewport's: a header strip over a
             body. Hidden until an arrangement shows it. -->
        <Grid x:Name="LogicPane" Grid.Column="0" Grid.Row="2" RowDefinitions="Auto,*"
              IsVisible="False">
          <shell:LogicHeaderStrip Grid.Row="0" x:Name="LogicHeader" />
          <Border Grid.Row="1" x:Name="LogicPaneBody"
                  Background="{StaticResource SpectraBgPanel}" />
        </Grid>

        <!-- One splitter per axis, in the gutter track. Each ink is its
             splitter's Tag, set in code: a failed binding in a subtree that
             moves between parents reports nothing. -->
        <GridSplitter x:Name="ViewColumnSplitter" Grid.Column="1" Grid.RowSpan="3"
                      ResizeDirection="Columns" Cursor="SizeWestEast" IsVisible="False"
                      PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnViewSplitterDragCompleted" />
        <Border x:Name="ViewColumnSplitInk" Grid.Column="1" Grid.RowSpan="3" Width="3" CornerRadius="1.5"
                Classes="splitink" HorizontalAlignment="Center" IsVisible="False" />

        <GridSplitter x:Name="ViewRowSplitter" Grid.Row="1" Grid.ColumnSpan="3"
                      ResizeDirection="Rows" Cursor="SizeNorthSouth" IsVisible="False"
                      PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnViewSplitterDragCompleted" />
        <Border x:Name="ViewRowSplitInk" Grid.Row="1" Grid.ColumnSpan="3" Height="3" CornerRadius="1.5"
                Classes="splitink" VerticalAlignment="Center" IsVisible="False" />
        </Grid>

        <!-- The bottom region's splitter. -->
        <GridSplitter x:Name="BottomSplitter" Grid.Column="2" Grid.Row="1" ResizeDirection="Rows" Cursor="SizeNorthSouth"
                      PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #BottomSplitInk}" />
        <Border x:Name="BottomSplitInk" Grid.Column="2" Grid.Row="1" Height="3" CornerRadius="1.5" Classes="splitink"
                VerticalAlignment="Center" />

        <!-- Same factory as the other docks, or panels cannot be dragged
             between regions. -->
        <Border Classes="tile" Grid.Column="2" Grid.Row="2" IsVisible="{Binding #BottomDock.IsVisible}">
        <dock:DockControl x:Name="BottomDock"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="BottomRoot" Id="BottomRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #BottomLayout}">
            <dm:ProportionalDock x:Name="BottomLayout" Id="BottomLayout" Orientation="Horizontal">
              <!-- No header: with several tools the tab strip already names
                   the open one, and it is the drag handle too. -->
              <dm:ToolDock Id="BottomToolDock" Alignment="Top" Proportion="1" GripMode="Hidden">
                <dm:Tool x:Name="ContentTool" Id="Content" Title="Content" CanClose="True" CanPin="False" />
                <dm:Tool x:Name="OutputTool" Id="Output" Title="Output" CanClose="True" CanPin="False" />
                <dm:Tool x:Name="ProblemsTool" Id="Problems" Title="Problems" CanClose="True" CanPin="False" />
                <dm:Tool x:Name="ConsoleTool" Id="Console" Title="Console" CanClose="True" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
        </Border>

        <GridSplitter x:Name="RightSplitter" Grid.Column="3" Grid.RowSpan="3" ResizeDirection="Columns" Cursor="SizeWestEast"
                      PointerEntered="OnSplitterEntered"
                      PointerExited="OnSplitterExited"
                      DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted"
                      Tag="{Binding #RightSplitInk}" />
        <Border x:Name="RightSplitInk" Grid.Column="3" Grid.RowSpan="3" Width="3" CornerRadius="1.5" Classes="splitink"
                HorizontalAlignment="Center" />

        <Border Classes="tile" Grid.Column="4" Grid.RowSpan="3" IsVisible="{Binding #RightDock.IsVisible}">
        <dock:DockControl x:Name="RightDock"
                          InitializeLayout="True" InitializeFactory="True">
          <dm:RootDock x:Name="RightRoot" Id="RightRoot" IsCollapsable="False"
                       FloatingWindowHostMode="Native"
                       DefaultDockable="{Binding #RightLayout}">
            <dm:ProportionalDock x:Name="RightLayout" Id="RightLayout" Orientation="Vertical">
              <dm:ToolDock Id="PropertiesDock" Alignment="Right" Proportion="1">
                <dm:Tool x:Name="PropertiesTool" Id="Properties" Title="Properties" CanClose="False" CanPin="False" />
              </dm:ToolDock>
            </dm:ProportionalDock>
          </dm:RootDock>
        </dock:DockControl>
        </Border>
      </Grid>
    </Panel>

    <!-- Status bar. Messages on the left; labelled, fixed-width readouts on
         the right so nothing jitters. -->
    <Border Grid.Row="3"
            Height="{StaticResource SpectraStatusBarHeight}"
            Background="{StaticResource SpectraBgApp}"
            Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">

        <!-- A dock panel, not a stack: a stack measures the text unbounded, so
             a long message never trims and runs under the readouts. -->
        <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <Path DockPanel.Dock="Left" Margin="0,0,6,0"
                Classes="icon" Width="13" Height="13" Data="{StaticResource IconWarning}"
                Stroke="{StaticResource SpectraTextDanger}" StrokeThickness="1.3"
                Stretch="Uniform" IsVisible="{Binding IsError}" />
          <TextBlock Classes="statusmsg" Classes.errormsg="{Binding IsError}"
                     Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasSession}">
          <!-- Static-world defect. Its own slot, so the message line cannot
               overwrite it: the level stops recompiling while it stands. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasWorldDefect}"
                      ToolTip.Tip="{Binding WorldDefectTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="level not rebuilding"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>

          <!-- Graphics debug-layer errors. These still render a picture, so
               this slot is the only place they show. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasDebugLayerErrors}"
                      ToolTip.Tip="{Binding DebugLayerTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="{Binding DebugLayerLabel}"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>

          <!-- Standing problem count; opens the Problems panel. -->
          <!-- Width NaN: a ghost button is square by default and would clip this. -->
          <Button Classes="ghost" Focusable="False" Padding="0" Margin="0" Width="NaN"
                  Background="Transparent" BorderThickness="0"
                  IsVisible="{Binding Problems.HasProblems}"
                  Click="OnShowProblemsPanel"
                  ToolTip.Tip="{Binding Problems.Summary}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                    Data="{StaticResource IconWarning}"
                    Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
              <TextBlock Classes="value" Text="{Binding Problems.CountLabel}"
                         Foreground="{StaticResource SpectraWarning}" />
              <Border Classes="groupsep" Margin="4,0" />
            </StackPanel>
          </Button>

          <!-- Missing content: references bound to the placeholder. Geometry
               that names no material is not counted. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding HasPlaceholderBound}"
                      ToolTip.Tip="{Binding PlaceholderBoundTip}">
            <Path Classes="icon" Width="13" Height="13" Stretch="Uniform"
                  Data="{StaticResource IconWarning}"
                  Stroke="{StaticResource SpectraWarning}" StrokeThickness="1.3" />
            <TextBlock Classes="value" Text="{Binding PlaceholderBoundLabel}"
                       Foreground="{StaticResource SpectraWarning}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding IsPlaying}">
            <Border Width="6" Height="6" CornerRadius="3"
                    Background="{StaticResource SpectraMode}" VerticalAlignment="Center" />
            <TextBlock Classes="value" Text="playing, F8 stops"
                       Foreground="{StaticResource SpectraMode}" />
            <Border Classes="groupsep" Margin="4,0" />
          </StackPanel>
          <TextBlock Classes="value" Text="{Binding SelectionLabel}" MinWidth="104"
                     Foreground="{StaticResource SpectraTextEmphasis}" />

          <!-- What the mouse and modifiers do right now. -->
          <Border Classes="groupsep" />
          <TextBlock Classes="value" Text="{Binding GestureHint}" MinWidth="240"
                     Foreground="{StaticResource SpectraTextMuted}" />

          <!-- Engine diagnostics, off by default. The separators are inside
               the panel so they hide with it. -->
          <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center"
                      IsVisible="{Binding ShowDiagnostics}">
            <Border Classes="groupsep" />
            <TextBlock Classes="value" Text="{Binding NodeCountLabel}"
                       Foreground="{StaticResource SpectraTextMuted}" MinWidth="70"
                       ToolTip.Tip="Nodes in the scene" />
            <Border Classes="groupsep" />
            <TextBlock Classes="label" Text="compiles" Margin="0,0,6,0" />
            <TextBlock Classes="value" Text="{Binding CompileCount}"
                       Foreground="{StaticResource SpectraTextMuted}" MinWidth="40"
                       ToolTip.Tip="Static-world recompiles this session" />
            <Border Classes="groupsep" />
            <TextBlock Classes="label" Text="viewport" Margin="0,0,6,0" />
            <TextBlock Classes="value" Text="{Binding ViewportLabel}"
                       Foreground="{StaticResource SpectraTextMuted}" MinWidth="66" />
            <Border Classes="groupsep" />
            <TextBlock Classes="value frametime" Classes.overbudget="{Binding FrameTimeOverBudget}"
                       Text="{Binding FpsLabel}" MinWidth="58"
                       ToolTip.Tip="{Binding FrameTimeLabel}" />
          </StackPanel>

          <!-- How long the render thread waited for this window to hand the
               shared texture back. If the frame rate drops and this is raised,
               the UI thread is the cause. -->
          <TextBlock Classes="value" Text="{Binding SharedAcquireLabel}"
                     IsVisible="{Binding SharedAcquireVisible}"
                     Foreground="{StaticResource SpectraWarning}"
                     Margin="8,0,0,0" MinWidth="96"
                     ToolTip.Tip="Longest wait for the composited viewport's shared texture in the last publish window. The keyed mutex is the clock, so this is UI-thread latency charged to the engine's frame rate." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
