<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent"
             x:Class="SpectraEngine.Editor.App"
             RequestedThemeVariant="Dark">

  <!--
    Dark only; there is no light palette.
    Order matters: Fluent first so its keys can be overridden, Tokens before
    Icons and Controls, which reference tokens by StaticResource.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SpectraEngine.Editor/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://SpectraEngine.Editor/Theme/Icons.axaml" />
        <!-- After Tokens, whose brushes it aliases. Application.Resources
             outranks Dock's own theme dictionary at DynamicResource time. -->
        <ResourceInclude Source="avares://SpectraEngine.Editor/Theme/DockTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Before Controls.axaml, so the shell's styles win where they overlap. -->
    <dockFluent:DockFluentTheme />
    <StyleInclude Source="avares://SpectraEngine.Editor/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
