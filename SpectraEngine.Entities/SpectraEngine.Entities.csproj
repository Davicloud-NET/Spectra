<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Entities</RootNamespace>
    <!-- Runs the trim/AOT analysers on the ordinary build, as in SpectraEngine.Core. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpectraEngine.Core\SpectraEngine.Core.csproj" />

    <!--
      Loaded as an analyzer, not referenced.
      UndefineProperties: a publish passes PublishAot and friends as global
      properties, which reach the netstandard2.0 generator and fail the publish
      with NETSDK1207.
    -->
    <ProjectReference Include="..\SpectraEngine.Entities.Generator\SpectraEngine.Entities.Generator.csproj"
                     OutputItemType="Analyzer"
                     ReferenceOutputAssembly="false"
                     UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained;PublishTrimmed;PublishSingleFile" />
  </ItemGroup>

</Project>
