<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn only loads analyzers built for netstandard2.0. Overrides Directory.Build.props. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>SpectraEngine.Entities.Generator</RootNamespace>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- An analyzer is loaded, never referenced. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release tracking (RS2008): the diagnostic id registry. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets: Roslyn supplies its own copy at load time. Version pin: see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
