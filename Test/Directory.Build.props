<Project>

  <!-- Inherit the repo-root Directory.Build.props (TargetFramework etc.). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!--
      The allocation tests assert on GC.GetAllocatedBytesForCurrentThread. A
      background GC drops every thread's allocation buffer and the counter
      then reports the unused part, up to 8 KB, as allocated. Blocking
      collections keep it exact.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
