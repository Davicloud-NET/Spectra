<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Editor.Render.Tests</RootNamespace>
    <!-- The sheet reader walks the frame buffer directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Separate from SpectraEngine.Editor.Tests, which must keep referencing no
    Avalonia. This suite runs a headless Avalonia platform: no X server, no GPU.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\SpectraEngine.Editor\SpectraEngine.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- Referenced directly because this project calls UseSkia itself. -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <!-- The level the Logic view was designed on. Linked, so the sheets and the
       model's tests draw the same one. -->
  <ItemGroup>
    <Compile Include="..\SpectraEngine.Editor.Tests\Logic\LogicFixture.cs" Link="Logic\LogicFixture.cs" />
    <Compile Include="..\SpectraEngine.Editor.Tests\Logic\LogicPlayFixture.cs" Link="Logic\LogicPlayFixture.cs" />
    <Compile Include="..\SpectraEngine.Editor.Tests\Logic\FixedWidthRuler.cs" Link="Logic\FixedWidthRuler.cs" />
  </ItemGroup>

  <!-- The WAV writer the cook's tests use, for the sheets that list sounds. -->
  <ItemGroup>
    <Compile Include="..\Spectra.Kitchen.Tests\TempProject.cs" Link="TempProject.cs" />
  </ItemGroup>

</Project>
