<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Editor.Render.Tests</RootNamespace>
    <!-- The sheet reader walks the frame buffer directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Separate from SpectraEngine.Editor.Tests, which must keep referencing no
    Avalonia. This suite runs a headless Avalonia platform: no X server, no GPU.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\SpectraEngine.Editor\SpectraEngine.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <!-- Referenced directly because this project calls UseSkia itself. -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

</Project>
