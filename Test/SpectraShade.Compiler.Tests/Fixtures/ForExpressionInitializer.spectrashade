// For loops whose initializer assigns a pre-declared counter. The generator
// must keep the initializer. Both `i = 0` and `(j = 0)` must parse.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader ForExpressionInitializer {
    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var result = new VertexOutput();
        result.position = vec4(input.position, 1.0);
        result.uv = input.uv;
        return result;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        var brightness = 0.0;
        var i = 0;
        var j = 0;
        for (i = 0; i < 4; i = i + 1) {
            brightness = brightness + 0.25;
        }
        for ((j = 0); j < 2; j = j + 1) {
            brightness = brightness - 0.125;
        }
        return vec4(brightness, brightness, brightness, 1.0);
    }
}
