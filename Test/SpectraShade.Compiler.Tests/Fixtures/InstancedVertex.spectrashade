// Model matrix as a per-instance vertex input instead of a cbuffer uniform.
// A mat4 takes four locations in both targets, so the next free one is 7.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec3 normal;
    [Location(2)] vec2 uv;

    // The rate is not in either target's shader text (GL uses a divisor, D3D
    // InputSlotClass), so the compiled output has to report it.
    [Location(3)][PerInstance] mat4 model;

    // Past the matrix, to check its span is counted.
    [Location(7)][PerInstance] vec4 tint;
}

struct VertexOutput {
    [Position] vec4 position;
    vec3 normal;
    vec2 uv;
    vec4 tint;
}

struct FragmentInput {
    vec3 normal;
    vec2 uv;
    vec4 tint;
}

shader InstancedVertex {
    [Binding(0)] cbuffer Camera {
        mat4 viewProjection;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = viewProjection * input.model * vec4(input.position, 1.0);
        output.normal = input.normal;
        output.uv = input.uv;
        output.tint = input.tint;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        return input.tint;
    }
}
