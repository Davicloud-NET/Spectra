// Whole-number float literals. Printed as "1", `1.0 / 3.0` becomes `1 / 3`,
// which is integer division in GLSL and evaluates to zero.

struct VertexInput {
    [Location(0)] vec3 position;
}

struct VertexOutput {
    [Position] vec4 position;
}

struct FragmentInput {
    vec2 uv;
}

shader WholeNumberFloats {
    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var output = new VertexOutput();
        output.position = vec4(input.position, 1.0);
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        float third = 1.0 / 3.0;
        float scaled = 2.0 * third;
        vec3 tint = vec3(1.0, 0.0, 0.0) * scaled;
        return vec4(tint, 1.0);
    }
}
