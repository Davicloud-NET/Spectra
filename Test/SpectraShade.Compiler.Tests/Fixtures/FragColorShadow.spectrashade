// A local named fragColor collides with the GLSL generator's own
// `out vec4 fragColor;`. Unescaped, it shadows the output and still compiles.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader FragColorShadow {
    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        var result = new VertexOutput();
        result.position = vec4(input.position, 1.0);
        result.uv = input.uv;
        return result;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        vec4 fragColor = vec4(input.uv, 0.0, 1.0);
        return fragColor;
    }
}
