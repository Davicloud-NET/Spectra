// A [Vertex] stage returning vec4 instead of an output struct. The value is
// the clip-space position and must reach the stage's position output.

struct VertexInput {
    [Location(0)] vec3 position;
}

shader BareVertexReturn {
    [Vertex]
    vec4 VertexMain(VertexInput input) {
        return vec4(input.position, 1.0);
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain() {
        return vec4(1.0, 0.0, 1.0, 1.0);
    }
}
