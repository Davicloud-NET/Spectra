// Returns nested in control flow in both stages, plus a helper-call return
// value. GLSL entries are void main(), so each return must lower to output
// assignments and a bare return.

struct VertexInput {
    [Location(0)] vec3 position;
    [Location(1)] vec2 uv;
}

struct VertexOutput {
    [Position] vec4 position;
    vec2 uv;
}

struct FragmentInput {
    vec2 uv;
}

shader NestedReturns {
    [Binding(0)] cbuffer Params {
        mat4 viewProjection;
        float threshold;
    }

    VertexOutput BuildOutput(vec4 clipPosition, vec2 uv) {
        var output = new VertexOutput();
        output.position = clipPosition;
        output.uv = uv;
        return output;
    }

    [Vertex]
    VertexOutput VertexMain(VertexInput input) {
        if (input.position.x < threshold) {
            return BuildOutput(vec4(input.position, 1.0) * viewProjection, vec2(1.0, 1.0) - input.uv);
        }
        var output = new VertexOutput();
        output.position = vec4(input.position, 1.0) * viewProjection;
        output.uv = input.uv;
        return output;
    }

    [Fragment] [Target(0)]
    vec4 FragmentMain(FragmentInput input) {
        if (input.uv.x > threshold) {
            if (input.uv.y > threshold) {
                return vec4(1.0, 0.0, 0.0, 1.0);
            }
            return vec4(0.0, 1.0, 0.0, 1.0);
        }
        return vec4(0.0, 0.0, 1.0, 1.0);
    }
}
