<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpectraEngine.Entities.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SpectraEngine.Entities\SpectraEngine.Entities.csproj" />
    <!-- A normal reference, not an analyzer: the tests run the generator themselves. -->
    <ProjectReference Include="..\..\SpectraEngine.Entities.Generator\SpectraEngine.Entities.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A scene manager loads a scene through a renderer. -->
    <Compile Include="..\SpectraEngine.Bsp.Tests\FakeRenderer.cs" Link="FakeRenderer.cs" />
    <Compile Include="..\SpectraEngine.Bsp.Tests\SpatialTestHelpers.cs" Link="SpatialTestHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must be the Roslyn version the generator is built against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
