--[[
What Roblox answers for a list of CFrame cases. The engine's CFrame is tested
against it.

Paste the whole file into the command bar of Roblox Studio and press Enter.
It prints one JSON document: each case's name with the twelve numbers of
GetComponents, or three for a vector or a set of angles. A number that is not
finite is written as null, and a case Roblox could not work out gets an empty
list. Save what it prints as cframe-studio.json beside this file, then run the
SpectraEngine.Bsp.Tests suite.

The lines between the two case marks are written by the tests from
CFrameProbeCases.cs. To write them again, run the suite once with
SPECTRA_WRITE_CFRAME_PROBE=1 set. Only block comments in this file: the
command bar may join the lines, and a line comment would then swallow the rest.
]]
local entries = {}

local function put(name, read)
	local ok, values = pcall(read)
	local parts = {}
	if ok then
		for index, value in ipairs(values) do
			if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
				parts[index] = "null"
			else
				parts[index] = string.format("%.9g", value)
			end
		end
	end
	table.insert(entries, string.format('"%s":[%s]', name, table.concat(parts, ",")))
end

local function frame(name, make)
	put(name, function()
		return { make():GetComponents() }
	end)
end

local function vector(name, make)
	put(name, function()
		local v = make()
		return { v.X, v.Y, v.Z }
	end)
end

local function angles(name, make)
	put(name, function()
		return { make() }
	end)
end

